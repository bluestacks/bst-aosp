+
 import java.lang.annotation.Retention;
 import java.lang.annotation.RetentionPolicy;
 import java.util.ArrayList;
@@ -98,6 +104,9 @@ public final class Display {
     private DisplayInfo mDisplayInfo; // never null
     private boolean mIsValid;
 
+    private String mLastPkg;
+    private boolean mModifyDisplayRotation = false;
+
     // Temporary display metrics structure used for compatibility mode.
     private final DisplayMetrics mTempMetrics = new DisplayMetrics();
 
@@ -552,6 +561,7 @@ public final class Display {
         mType = displayInfo.type;
         mOwnerUid = displayInfo.ownerUid;
         mOwnerPackageName = displayInfo.ownerPackageName;
+        mLastPkg = "";
     }
 
     /**
@@ -922,7 +932,31 @@ public final class Display {
     @Surface.Rotation
     public int getRotation() {
         synchronized (mLock) {
+            // Bug 8230: com.icantw.wings unable to click in game. This app is querying default orientation of the device based on
+            // display rotation and size (point.x and point.y). Returning default tablet rotation to this app fixes the issue of
+            // click not working in app.
+            // We ask BstFilterAppsService for info on packages we need to modify rotation values.
+            try {
+                if (Binder.getCallingUid() >= 10000) {
+                    int pid = android.os.Process.myPid();
+                    String callingApp = BstUtils.getAppNameFromPid(pid);
+                    if(mLastPkg.compareTo(callingApp) != 0) {
+                        if (DEBUG) Log.w(TAG, "trying to query bstfilter apps service for pkg: " + callingApp);
+                        IBstFilterAppsService bstfilter = IBstFilterAppsService.Stub.asInterface(ServiceManager.getService(Context.BST_FILTER_APPS));
+                        mModifyDisplayRotation = bstfilter.isModifyDisplayRotationApp(callingApp);
+                        mLastPkg = callingApp;
+                    }
+                }
+            } catch (Exception exe) {
+                Log.w(TAG, "Exception while querying for Modify Display Rotation app: " + exe);
+                exe.printStackTrace();
+            }
+
             updateDisplayInfoLocked();
+            if (mModifyDisplayRotation) {
+                return ((mDisplayInfo.rotation == 0) ? 1 : 0);
+            }
+
             return getLocalRotation();
         }
     }
