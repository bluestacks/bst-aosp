+     * @param uid Caller UID
+     * @return true if the caller is a third-party application
+     */
+    private boolean isThirdPartyCaller(int uid) {
+        try {
+            // Get caller's package information
+            String[] packages = getPackagesForUid(uid);
+            if (packages == null || packages.length == 0) {
+                return false; // Cannot determine, conservative handling
+            }
