     private static final int UWB_UID = Process.UWB_UID;
 
+    // Flags to disable permission revoke for bluestacks apps.
+    private static final boolean BST_DEBUG = SystemProperties.getInt("bst.debug.pm", 0) == 0 ? false : true;
+
     static final int SCAN_NO_DEX = 1 << 0;
     static final int SCAN_UPDATE_SIGNATURE = 1 << 1;
     static final int SCAN_NEW_INSTALL = 1 << 2;
@@ -663,6 +669,7 @@ public class PackageManagerService implements PackageSender, TestUtilityService
     private final String mIncrementalVersion;
 
     PackageManagerInternal.ExternalSourcesPolicy mExternalSourcesPolicy;
+    BstFilterAppsManager mBstfilter = null;
 
     @GuardedBy("mAvailableFeatures")
     private final ArrayMap<String, FeatureInfo> mAvailableFeatures;
@@ -2750,6 +2757,54 @@ public class PackageManagerService implements PackageSender, TestUtilityService
     }
 
     public boolean hasSystemFeature(String name, int version) {
+        /* Hide android.hardware.faketouch */
+        if (("android.hardware.faketouch".equalsIgnoreCase(name))
+                && (Binder.getCallingUid() >= 10000)) {
+            return false;
+        }
+
+        /* Hide android.hardware.ethernet */
+        if (("android.hardware.ethernet".equalsIgnoreCase(name))
+                && (Binder.getCallingUid() >= 10000)) {
+            return false;
+        }
+
+        if ("android.hardware.opengles.aep".equalsIgnoreCase(name)) {
+            int pid = Binder.getCallingPid();
+            int uid = Binder.getCallingUid();
+            if (uid >= 10000) {
+                String pkgName = BstUtils.getAppNameFromPid(pid);
+                if ("com.android.vending".equalsIgnoreCase(pkgName)) {
+                    return true;
+                }
+            }
+        }
+
+        /* Making sure that this check for partner app happens irrespective of whether its a china build or not. */
+        if (("android.hardware.bluestacks".equalsIgnoreCase(name))
+                || ("android.hardware.nap".equalsIgnoreCase(name))) {
+            // When an app enquires about Bluestacks from System Features we confirm them that they are running on Bluestacks
+            // if they are one of our partner apps.
+            int pid = Binder.getCallingPid();
+            int uid = Binder.getCallingUid();
+            if (uid >= 10000) {
+                String callingApp = BstUtils.getAppNameFromPid(pid);
+                if (mBstfilter == null) {
+                    mBstfilter = (BstFilterAppsManager) mContext.getSystemService(Context.BST_FILTER_APPS);
+                }
+                if (mBstfilter.isBluestacksPartnerApp(callingApp)) {
+                    return true;
+                }
+            }
+        }
+
+        if ("android.hardware.nowgg".equalsIgnoreCase(name)) {
+            int pid = Binder.getCallingPid();
+            String pkgName = BstUtils.getAppNameFromPid(pid);
+            if (BST_DEBUG) Log.d(TAG, "Package "+pkgName+" queried for feature "+name);
+            reportNowggPltfDetectionToCloud(pkgName);
+            return true ;
+        }
         // allow instant applications
         synchronized (mAvailableFeatures) {
             final FeatureInfo feat = mAvailableFeatures.get(name);
@@ -2761,6 +2816,31 @@ public class PackageManagerService implements PackageSender, TestUtilityService
         }
     }
 
+
+    private void reportNowggPltfDetectionToCloud(String packageName) {
+        String versionName = "";
+        String versionCode = "";
+        try {
+            Computer computer = snapshotComputer();
+            PackageInfo pkgInfo = computer.getPackageInfo(packageName, 0 ,0);
+            versionName = pkgInfo.versionName;
+            versionCode = Integer.toString(pkgInfo.versionCode);
+        } catch (Exception ex) {
+            Log.e(TAG, "Exception: " + ex.getMessage());
+            if (BST_DEBUG) ex.printStackTrace();
+        }
+        Intent intent = new Intent();
+        ComponentName cn = new ComponentName("com.bluestacks.BstCommandProcessor",
+                "com.bluestacks.BstCommandProcessor.BstCommandProcessorService");
+        intent.setAction("reportNowggPlatformDetection");
+        intent.setComponent(cn);
+        intent.putExtra("pkgname", packageName);
+        intent.putExtra("versionname", versionName != null ? versionName : "");
+        intent.putExtra("versioncode", versionCode);
+        mContext.startServiceAsUser(intent, Process.myUserHandle());
+    }
+
+
     // NOTE: Can't remove due to unsupported app usage
     public int checkPermission(String permName, String pkgName, int userId) {
         return mPermissionManager.checkPermission(pkgName, permName, userId);
@@ -5046,6 +5126,19 @@ public class PackageManagerService implements PackageSender, TestUtilityService
 
         @Override
         public @NonNull ParceledListSlice<FeatureInfo> getSystemAvailableFeatures() {
+            int pid = Binder.getCallingPid();
+            int uid = Binder.getCallingUid();
+            String pkgName = "";
+            int reqGlEsVersion = -1;
+
+            if (uid >= 10000) {
+                if (mBstfilter == null) {
+                    mBstfilter = (BstFilterAppsManager) mContext.getSystemService(Context.BST_FILTER_APPS);
+                }
+                pkgName = BstUtils.getAppNameFromPid(pid);
+                reqGlEsVersion = mBstfilter.getGlVersion(pkgName);
+            }
+
             // allow instant applications
             ArrayList<FeatureInfo> res;
             synchronized (mAvailableFeatures) {
@@ -5053,10 +5146,35 @@ public class PackageManagerService implements PackageSender, TestUtilityService
                 res.addAll(mAvailableFeatures.values());
             }
             final FeatureInfo fi = new FeatureInfo();
-            fi.reqGlEsVersion = SystemProperties.getInt("ro.opengles.version",
-                    FeatureInfo.GL_ES_VERSION_UNDEFINED);
+            fi.reqGlEsVersion = reqGlEsVersion != -1
+                ? reqGlEsVersion : SystemProperties.getInt("ro.opengles.version", FeatureInfo.GL_ES_VERSION_UNDEFINED);
             res.add(fi);
 
+            /*
+              We show gl version as 3.0 from /data/bluestacks.prop (ro.opengles.version=196608)
+              But for Play store show this value as 3.2 as it filters app based on this property
+              <uses-feature android:glEsVersion="0x00030002" android:required="true"/>
+              Adding feature as this is also used for filtering
+              <uses-feature android:name="android.hardware.opengles.aep" android:required="true"/>
+            */
+
+            if ("com.android.vending".equalsIgnoreCase(pkgName)) {
+                final FeatureInfo featureInfo = new FeatureInfo();
+                featureInfo.name = "android.hardware.opengles.aep";
+                res.add(featureInfo);
+            }
+
+            if (uid >= 10000) {
+                int size = res.size();
+                for (int i = 0; i < size; i++) {
+                    if ("android.hardware.faketouch".equalsIgnoreCase(res.get(i).name)
+                            || "android.hardware.ethernet".equalsIgnoreCase(res.get(i).name)) {
+                        res.remove(i);
+                        size--;
+                    }
+                }
+            }
+
             return new ParceledListSlice<>(res);
         }
 
