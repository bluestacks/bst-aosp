+    public void bstHandleBlacklistedApps(ParsedPackage parsedPackage) {
+        PackageSetting pkgSetting;
+        final String renamedPkgName = mPm.mSettings.getRenamedPackageLPr(AndroidPackageUtils.getRealPackageOrNull(parsedPackage));
+        final String realPkgName = ScanPackageUtils.getRealPackageName(parsedPackage, renamedPkgName);
+        if (realPkgName != null) {
+            ScanPackageUtils.ensurePackageRenamed(parsedPackage, renamedPkgName);
+        }
+        final PackageSetting originalPkgSetting = getOriginalPackageLocked(parsedPackage,
+                renamedPkgName);
+        final PackageSetting installedPkgSetting = mPm.mSettings.getPackageLPr(
+                parsedPackage.getPackageName());
+        pkgSetting = originalPkgSetting == null ? installedPkgSetting : originalPkgSetting;
+        try {
+            BstFilterAppsManager bstfilter = (BstFilterAppsManager) mContext.getSystemService(Context.BST_FILTER_APPS);
+            // Check for blacklist action if app is either not a system app or is an updated system app
+            if (pkgSetting != null && (!PackageManagerServiceUtils.isSystemApp(pkgSetting) ||
+                    PackageManagerServiceUtils.isUpdatedSystemApp(pkgSetting))) {
+                int state = mPm.snapshotComputer().getApplicationEnabledSetting(parsedPackage.getPackageName(),
+                        UserHandle.USER_SYSTEM);
+                String blacklistAction = bstfilter.getBlackListAction(parsedPackage.getPackageName());
+                PackageManagerService.IPackageManagerImpl iPackageManager = mPm.new IPackageManagerImpl();
+                if (bstfilter.isBlackListed(parsedPackage.getPackageName(), parsedPackage.getVersionName())) {
+                    if (blacklistAction.equalsIgnoreCase("disable")) {
+                        if (state != COMPONENT_ENABLED_STATE_DISABLED){
+                        iPackageManager.setApplicationEnabledSetting(parsedPackage.getPackageName(), COMPONENT_ENABLED_STATE_DISABLED, 0,
+                                    UserHandle.USER_SYSTEM, mContext.getBasePackageName());
+                        }
+                    } else if (blacklistAction.equalsIgnoreCase("uninstall")) {
+                        mPm.getBstUninstallPkgList().add(parsedPackage.getPackageName());
+                    }
+                }
+                if (blacklistAction.equalsIgnoreCase("enable") && state == COMPONENT_ENABLED_STATE_DISABLED) {
+                    iPackageManager.setApplicationEnabledSetting(parsedPackage.getPackageName(), COMPONENT_ENABLED_STATE_ENABLED, 0,
+                            UserHandle.USER_SYSTEM, mContext.getBasePackageName());
+                }
+            }
+        } catch (Exception e) {
+            Slog.e(TAG,"Exception in PackageManagerService while deleting blacklisted app " + parsedPackage.getPackageName() + " : " + e.getMessage());
+        }
+    }
 }
