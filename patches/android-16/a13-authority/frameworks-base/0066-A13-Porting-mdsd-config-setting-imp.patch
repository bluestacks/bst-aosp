@@ -157,6 +162,10 @@ public class Environment {
     private static UserEnvironment sCurrentUser;
     private static boolean sUserRequired;
 
+    // BST: Sdcard emulation path in /data partition for cases like 14080, 12660.
+    private static final String SDCARD_EMUL_PATH = "/sdcard_emul";
+    private static boolean modifySdPathForFnCall = false;
+
     static {
         initForCurrentUser();
     }
@@ -182,6 +191,51 @@ public class Environment {
             final StorageVolume[] volumes = StorageManager.getVolumeList(mUserId,
                     StorageManager.FLAG_FOR_WRITE);
             final File[] files = new File[volumes.length];
+
+            // Case 14080, 12660 temp fix.
+            // Apps download large zipped resource files under externalStorage. It takes time to unzip/open/read
+            // such resources which results in app progress loader stuck for a long time giving a expression that the app is not
+            // loading.
+            // Modifying externalStorage dir for all such apps as of now.
+            // Asking BstFilterAppsService whether the packageName is one for which we need to modify this path.
+
+            try {
+                int pid = android.os.Process.myPid();
+                String packageName = BstUtils.getAppNameFromPid(pid);
+                IBstFilterAppsService mBstFilter = IBstFilterAppsService.Stub.asInterface(ServiceManager.getService(Context.BST_FILTER_APPS));
+                File[] cachedOrigExternalPath = new File[1];
+                cachedOrigExternalPath[0] = volumes[0].getPathFile();
+
+                if (modifySdPathForFnCall && packageName != null && mBstFilter.isModifysdPathReqd(packageName)) {
+                    // Let us change the externalDir for this app.
+                    String emulatedExternalStorageDir = new StringBuilder(DIR_DATA).append("/").append(packageName).append(SDCARD_EMUL_PATH).toString();
+                    // Not populating other volume lengths for now.
+                    files[0] = new File(DIR_ANDROID_DATA, emulatedExternalStorageDir);
+
+                    // Case BS4-2783: The obb file is downloaded and installed by vending in /sdcard/Android/obb/<pkg>/.
+                    // We do not modify the obb path even for isModifysdPathReqd packages.
+                    // However, if such app tries to build the obb path manually via getExternalStorageDirectory() and appending
+                    // "/Android/obb", it will result in detecting missing obb file as seen in app Rangers of Oblivion.
+                    // Hence, creating a symlink to the dowloaded obb file to bypass such error.
+                    File emulatedObbPath = (buildPaths(files, DIR_ANDROID, DIR_OBB))[0];
+                    File actualObbPath = (buildPaths(cachedOrigExternalPath, DIR_ANDROID, DIR_OBB, packageName))[0];
+                    String[] actualObbPathFiles = actualObbPath.list();
+                    if (actualObbPathFiles != null && actualObbPathFiles.length > 0 && !emulatedObbPath.exists()) {
+                        // Let us create the obb dir under sdcard_emul dir and create a symlink to the actual
+                        // obb dir created for the pkg in /sdcard.
+                        emulatedObbPath.mkdirs();
+                        File emulatedObbFullPath = new File(emulatedObbPath, packageName);
+                        Os.symlink(actualObbPath.toString(), emulatedObbFullPath.toString());
+                    }
+                    return files;
+                }
+            } catch (Exception e) {
+                // If exception generated, let us fallback to original flow.
+                Log.w(TAG, "Error in getting isModifysdPathReqd from bstFilterAppsService, exception: " + e.getMessage());
+            } finally {
+                modifySdPathForFnCall = false;
+            }
+
             for (int i = 0; i < volumes.length; i++) {
                 files[i] = volumes[i].getPathFile();
             }
@@ -203,6 +257,7 @@ public class Environment {
         }
 
         public File[] buildExternalStorageAndroidDataDirs() {
+            modifySdPathForFnCall = true;
