+#ifndef WIDEVINE_CRYPTO_PLUGIN_H_
+#define WIDEVINE_CRYPTO_PLUGIN_H_
+
+#include <android/hidl/memory/1.0/IMemory.h>
+#include <android/hardware/drm/1.2/ICryptoPlugin.h>
+#include <hidl/Status.h>
