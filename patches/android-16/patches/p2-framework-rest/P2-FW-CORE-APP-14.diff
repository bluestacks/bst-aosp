+            Slog.e(TAG, "getBstAbiOverride cannot call BstFilterApps : " + exc);
+            exc.printStackTrace();
+        }
+        if (cpuAbi == null) {
+            return getAbiListForAbiValue();
+        }
+        else {
+            return cpuAbi;
+        }
+    }
