From: yangjiashun-bst <103926735+yangjiashun-bst@users.noreply.github.com>
Date: Mon, 24 Nov 2025 18:01:07 +0800
Subject: [PATCH 209/224] Add accessible installation services and support
 Google Player's automatic click to install feature

---
 .../providers/settings/SettingsProvider.java  | 20 +++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/packages/SettingsProvider/src/com/android/providers/settings/SettingsProvider.java b/packages/SettingsProvider/src/com/android/providers/settings/SettingsProvider.java
index 8fee6eec14c5..4a7081ae8d7a 100644
--- a/packages/SettingsProvider/src/com/android/providers/settings/SettingsProvider.java
+++ b/packages/SettingsProvider/src/com/android/providers/settings/SettingsProvider.java
@@ -3668,7 +3668,7 @@ public class SettingsProvider extends ContentProvider {
         }
 
         private final class UpgradeController {
-            private static final int SETTINGS_VERSION = 212;
+            private static final int SETTINGS_VERSION = 213;
 
             private final int mUserId;
 
@@ -5583,7 +5583,23 @@ public class SettingsProvider extends ContentProvider {
 
                     currentVersion = 212;
                 }
-
+                if (currentVersion == 212) {
+                    final String bstAccessibilityService = "com.bluestacks.home/com.bluestacks.svc.services.GPAccessibilityService";
+                    final SettingsState secureSettings = getSecureSettingsLocked(userId);
+                    final String currentServices = secureSettings.getSettingLocked(
+                            Secure.ENABLED_ACCESSIBILITY_SERVICES).getValue();
+                    if (currentServices == null || !currentServices.contains(bstAccessibilityService)) {
+                        secureSettings.insertSettingLocked(
+                                Secure.ENABLED_ACCESSIBILITY_SERVICES,
+                                bstAccessibilityService,
+                                null, true, SettingsState.SYSTEM_PACKAGE_NAME);
+                        secureSettings.insertSettingLocked(
+                                Secure.ACCESSIBILITY_ENABLED,
+                                Integer.toString(1),
+                                null, true, SettingsState.SYSTEM_PACKAGE_NAME);
+                    }
+                    currentVersion = 213;
+                }
                 // vXXX: Add new settings above this point.
 
                 if (currentVersion != newVersion) {
