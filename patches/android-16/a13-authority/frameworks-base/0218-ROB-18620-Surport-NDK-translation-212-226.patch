     return "";
 }
 
+bool bst_is_ndk_translation_app(const char *calling_pkg)
+{
+#define NDK_TRANSLAION_FILE_PATH "/data/downloads/.tmp/.bstNdkTranslationApps"
+    char *file_buf, *temp, *token;
+    loff_t file_size  = 0;
+    bool ret = false;
+
+    file_buf = _bst_read_small_file(NDK_TRANSLAION_FILE_PATH, &file_size);
+    if (!file_buf || !calling_pkg)
+        goto out;
+
+    // Read app name line by line
+    temp = file_buf;
+    while ((token = strsep(&temp, ";")) != NULL && strlen(token) > 0) {
+        if (strcmp(token, calling_pkg) == 0) {
+            ret = true;
+            break;
+        }
+    }
+
+out:
+    if (file_buf)
+        free(file_buf);
+
+    return ret;
+}
+
 bool bst_get_memorysize_app(const char *calling_pkg, char *pbuf, int bufsize)
 {
 #define MEMORYSIZE_FILE_PATH "/data/downloads/.tmp/.bstMemorySizeApps"
@@ -2171,6 +2198,19 @@ static void SpecializeCommon(JNIEnv* env, uid_t uid, gid_t gid, jintArray gids,
                 ALOGW("Failed to bind-mount %s as /proc/cpuinfo: %s", cpuinfo_path, strerror(errno));
             }
         }
+
+        if (uid >= 10000 && bst_is_ndk_translation_app(g_pkgname)) {
+            // Mounting ndk_translation arm64 libs for apps for which "ndk" entry is present in config.db
+            char ndk_translation_arm_path[32] = "/system/lib64/arm64_ndk";
+            if (TEMP_FAILURE_RETRY(mount(ndk_translation_arm_path,        // Source.
+                                    "/system/lib64/arm64", // Target.
+                                    nullptr,               // FS type.
+                                    MS_BIND,               // Mount flags: bind mount.
+                                    nullptr)) == -1) {     // "Data."
+                ALOGW("Failed to bind-mount %s as /system/lib64/arm64: %s", ndk_translation_arm_path, strerror(errno));
+            }
+        }
+
     }
 
     if (is_system_server) {
