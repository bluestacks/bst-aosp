From 7151a45339efcb58a1fda8dce0c5d87ec2feb284 Mon Sep 17 00:00:00 2001
From: muzhong-bst <muzhong@bluestacks.com>
Date: Wed, 8 Nov 2023 14:19:57 +0800
Subject: [PATCH] [A13] Port cpuinfo bindmount

For /proc/cpuinfo and /etc/cpuinfo
---
 libnativebridge/native_bridge.cc | 33 ++++++++++++++++++++++++--------
 1 file changed, 25 insertions(+), 8 deletions(-)
 mode change 100644 => 100755 libnativebridge/native_bridge.cc

diff --git a/libnativebridge/native_bridge.cc b/libnativebridge/native_bridge.cc
old mode 100644
new mode 100755
index fb13d62be0..9f808ee230
--- a/libnativebridge/native_bridge.cc
+++ b/libnativebridge/native_bridge.cc
@@ -300,6 +300,7 @@ bool NeedsNativeBridge(const char* instruction_set) {
 
 #ifndef __APPLE__
 static bool MountCpuinfo(const char* cpuinfo_path) {
+  bool ret = true;
   // If the file does not exist, the mount command will fail,
   // so we save the extra file existence check.
   if (TEMP_FAILURE_RETRY(mount(cpuinfo_path,        // Source.
@@ -308,9 +309,19 @@ static bool MountCpuinfo(const char* cpuinfo_path) {
                                MS_BIND,             // Mount flags: bind mount.
                                nullptr)) == -1) {   // "Data."
     ALOGW("Failed to bind-mount %s as /proc/cpuinfo: %s", cpuinfo_path, strerror(errno));
-    return false;
+    ret = false;
   }
-  return true;
+
+  if (TEMP_FAILURE_RETRY(mount(cpuinfo_path,        // Source.
+                               "/etc/cpuinfo",     // Target.
+                               nullptr,             // FS type.
+                               MS_BIND,             // Mount flags: bind mount.
+                               nullptr)) == -1) {   // "Data."
+    ALOGW("Failed to bind-mount %s as /etc/cpuinfo: %s", cpuinfo_path, strerror(errno));
+    ret = false;
+  }
+
+  return ret;
 }
 #endif
 
@@ -337,22 +348,28 @@ static void MountCpuinfoForInstructionSet(const char* instruction_set) {
   MountCpuinfo("./cpuinfo");
 
 #else  // __ANDROID__
-  char cpuinfo_path[1024];
+  char cpuinfo_path[512];
+  char cpuinfo_path_backup[512];
 
-  // Bind-mount /system/etc/cpuinfo.<isa>.txt to /proc/cpuinfo.
-  snprintf(cpuinfo_path, sizeof(cpuinfo_path), "/system/etc/cpuinfo.%s.txt", instruction_set);
+  snprintf(cpuinfo_path, sizeof(cpuinfo_path), "/data/downloads/.oh/cpuinfo/%s/cpuinfo", instruction_set);
   if (MountCpuinfo(cpuinfo_path)) {
     return;
   }
 
+  // Bind-mount /system/etc/cpuinfo.<isa>.txt to /proc/cpuinfo.
+  snprintf(cpuinfo_path_backup, sizeof(cpuinfo_path_backup), "/system/etc/cpuinfo.%s.txt", instruction_set);
+  if (MountCpuinfo(cpuinfo_path_backup)) {
+    return;
+  }
+
   // Bind-mount /system/lib{,64}/<isa>/cpuinfo to /proc/cpuinfo.
   // TODO(b/179753190): remove when all implementations migrate to system/etc!
 #ifdef __LP64__
-  snprintf(cpuinfo_path, sizeof(cpuinfo_path), "/system/lib64/%s/cpuinfo", instruction_set);
+  snprintf(cpuinfo_path_backup, sizeof(cpuinfo_path_backup), "/system/lib64/%s/cpuinfo", instruction_set);
 #else
-  snprintf(cpuinfo_path, sizeof(cpuinfo_path), "/system/lib/%s/cpuinfo", instruction_set);
+  snprintf(cpuinfo_path_backup, sizeof(cpuinfo_path_backup), "/system/lib/%s/cpuinfo", instruction_set);
 #endif  // __LP64__
-  MountCpuinfo(cpuinfo_path);
+  MountCpuinfo(cpuinfo_path_backup);
 
 #endif
 }
