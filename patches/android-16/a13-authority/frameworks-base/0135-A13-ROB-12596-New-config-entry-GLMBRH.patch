+                                else if (key.equalsIgnoreCase("GLMBRH")) {
+                                    synchronized (mGlMapBufferRangeHostAppList) {
+                                        if (value.equalsIgnoreCase("false")) {
+                                            packageName = "~" + packageName;
+                                        }
+                                        if (DEBUG)
+                                            Slog.d(TAG, "Adding " + packageName + " to mGlMapBufferRangeHostAppList \n");
+                                        mGlMapBufferRangeHostAppList.add(packageName);
+                                        if (packageName.startsWith("~")) {
