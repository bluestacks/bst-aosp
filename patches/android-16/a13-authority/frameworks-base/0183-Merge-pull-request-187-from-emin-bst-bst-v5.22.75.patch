+    /* This new function is used to change DPI value of specified apps at runtime. */
+    public void changeDisplayDensity(String packageName, String activityName) {
+         String topPackageName = packageName != null ? packageName : android.os.SystemProperties.get("bst.config.top_package_name", null);
+         if (topPackageName == null || topPackageName.isEmpty()) {
+            return;
+         }
+
+         String customDpi = mBstFilterApps.getCustomDpi(topPackageName);
+         int density = 0;
+
+         if (customDpi.equals("160") || customDpi.equals("240") || customDpi.equals("320") || customDpi.equals("400") || customDpi.equals("480")) {
+            density = Integer.parseInt(customDpi);
+         }
+
+         if (density > 0) {
+            String topActivityName = activityName != null ? activityName : android.os.SystemProperties.get("bst.config.top_activity_name", null);
+            int index = topActivityName.indexOf('/');
+            if (index >= 0) {
+                topActivityName = topActivityName.substring(index + 1);
+            }
+         }
+
+         try {
+             int initialDensity = getInitialDisplayDensity(Display.DEFAULT_DISPLAY);
+             int currDensity = getBaseDisplayDensity(Display.DEFAULT_DISPLAY);
+
+             if (density > 0 && currDensity != density) {
+                setForcedDisplayDensityforApp(Display.DEFAULT_DISPLAY, density, UserHandle.USER_CURRENT);
+
+             } else if (density == 0 && initialDensity != currDensity) {
+                clearForcedDisplayDensityForApp(Display.DEFAULT_DISPLAY, UserHandle.USER_CURRENT);
+             }
+
+         } catch (Exception e) {
+             Slog.i(TAG, "Exception in changing setting density to " + density);
+             e.printStackTrace();
+         }
+    }
+
