 .../bluestacks/os/BstFilterAppsManager.java   | 15 ++++++
 .../bluestacks/os/IBstFilterAppsService.aidl  |  1 +
 .../server/BstFilterAppsService.java          | 50 +++++++++++++++++++
 3 files changed, 66 insertions(+)

diff --git a/core/java/com/bluestacks/os/BstFilterAppsManager.java b/core/java/com/bluestacks/os/BstFilterAppsManager.java
index 6b78ef5a6831..c38bb3591194 100755
--- a/core/java/com/bluestacks/os/BstFilterAppsManager.java
+++ b/core/java/com/bluestacks/os/BstFilterAppsManager.java
@@ -1890,4 +1890,19 @@ public class BstFilterAppsManager {
             return false;
         }
     }
+
+    /**
+     * @hide
+     */
+    public boolean isBptcApp(String pkgName)
+    {
+        try {
+            return mService.isBptcApp(pkgName);
+        } catch(Exception e) {
+            // Catching the error and returning default behavior as if entry was not
+            // present in config.db
+            if (DEBUG) e.printStackTrace();
+            return false;
+        }
+    }
 }
