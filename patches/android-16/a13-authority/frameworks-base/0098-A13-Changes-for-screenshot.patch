+    private void bstSaveFileInSharedFolder(String fileName, Uri uri) {
+        ContentResolver resolver = (ContentResolver)mContext.getContentResolver();
+        try {
+            ParcelFileDescriptor parcelFile = resolver.openFileDescriptor(uri, "r");
+            FileInputStream fis = new FileInputStream(parcelFile.getFileDescriptor());
+            File dest = new File("/mnt/windows/BstSharedFolder/" + fileName);
+
+            try (FileOutputStream fos = new FileOutputStream(dest)) {
+                byte[] buffer = new byte[1024];
+                int length;
+
+                while ((length = fis.read(buffer)) > 0) {
+                    fos.write(buffer, 0, length);
+                }
+            } catch (Exception ex) {
+                ex.printStackTrace();
+            }
+
+        } catch (IOException e) {
+            e.printStackTrace();
+        }
+    }
+
