+++ b/core/java/com/bluestacks/os/BstFilterAppsManager.java
@@ -1737,4 +1737,19 @@ public class BstFilterAppsManager {
             return false;
         }
     }
+
+    /**
+     * @hide
+     */
+    public boolean isGLVBOCacheDisableApp(String pkgName)
+    {
+        try{
+            return mService.isGLVBOCacheDisableApp(pkgName);
+	} catch(Exception e) {
