+    private Setting filterEnabledAccessibilityServicesForThirdParty(Setting originalSetting, int callingUid) {
+        // Check if caller is third-party
+        if (!isThirdPartyCaller(callingUid)) {
+            return originalSetting; // System apps can see all services
+        }
+        
+        if (originalSetting == null || originalSetting.getValue() == null) {
+            return originalSetting;
+        }
+        
+        // Define hidden accessibility services
+        final Set<String> hiddenServices = new ArraySet<>();
+        hiddenServices.add("com.bluestacks.home/com.bluestacks.svc.services.GPAccessibilityService");
+        hiddenServices.add("com.bluestacks.BstCommandProcessor/.UiAccessibilityService");
+        hiddenServices.add("com.bluestacks.BstCommandProcessor/com.bluestacks.BstCommandProcessor.UiAccessibilityService");
+        
+        String enabledServices = originalSetting.getValue();
+        String[] services = enabledServices.split(":");
+        StringBuilder filteredServices = new StringBuilder();
+        
+        for (String service : services) {
+            if (service != null && !service.trim().isEmpty()) {
+                // Filter out hidden accessibility services for third-party apps
+                if (!hiddenServices.contains(service)) {
+                    if (filteredServices.length() > 0) {
+                        filteredServices.append(":");
+                    }
+                    filteredServices.append(service);
+                }
+            }
+        }
+        
+        // Get the SettingsState instance to create new Setting
+        final SettingsState settingsState = mSettingsRegistry.getSettingsLocked(
+                SETTINGS_TYPE_SECURE, UserHandle.getUserId(callingUid));
+        
+        // Create new setting with filtered value
+        return settingsState.new Setting(
+                originalSetting.getName(),
+                filteredServices.toString(),
+                originalSetting.getTag(),
+                originalSetting.getDefaultValue(),
+                originalSetting.getPackageName(),
+                originalSetting.isDefaultFromSystem(),
+                originalSetting.getId()
+        ) {
+            @Override
+            public String getValue() {
+                return filteredServices.toString();
+            }
+        };
+    }
+    
+    private boolean isThirdPartyCaller(int uid) {
+        try {
+            // Get package info for the calling UID
+            String[] packages = mPackageManager.getPackagesForUid(uid);
+            if (packages == null || packages.length == 0) {
+                if (DEBUG) {
+                    Slog.d(LOG_TAG, "isThirdPartyCaller: uid=" + uid + ", packages=null, result=false (unknown caller)");
+                }
+                return false; // Unknown caller, assume system
+            }
+            
+            // Debug: log all packages for this UID
+            StringBuilder packageList = new StringBuilder();
+            for (String pkg : packages) {
+                if (packageList.length() > 0) packageList.append(", ");
+                packageList.append(pkg);
+            }
+            if (DEBUG) {
+                Slog.d(LOG_TAG, "isThirdPartyCaller: uid=" + uid + ", packages=[" + packageList.toString() + "]");
+            }
+            
+            // Check if any package is a system app
+            for (String packageName : packages) {
+                ApplicationInfo appInfo = mPackageManager.getApplicationInfo(packageName, 
+                        PackageManager.GET_UNINSTALLED_PACKAGES, UserHandle.USER_SYSTEM);
+                if (appInfo != null && ((appInfo.flags & ApplicationInfo.FLAG_SYSTEM) != 0 || 
+                    (appInfo.flags & ApplicationInfo.FLAG_UPDATED_SYSTEM_APP) != 0)) {
+                    if (DEBUG) {
+                        Slog.d(LOG_TAG, "isThirdPartyCaller: uid=" + uid + ", package=" + packageName + 
+                               " is system app (flags=" + appInfo.flags + "), result=false");
+                    }
+                    return false; // System app found
+                }
+            }
+            
+            if (DEBUG) {
+                Slog.d(LOG_TAG, "isThirdPartyCaller: uid=" + uid + ", no system apps found, result=true (third-party)");
+            }
+            return true; // No system apps found, it's third-party
+        } catch (Exception e) {
+            Slog.e(LOG_TAG, "isThirdPartyCaller: uid=" + uid + ", exception occurred, result=false", e);
+            // If we can't determine, assume system for safety
+            return false;
+        }
+    }
