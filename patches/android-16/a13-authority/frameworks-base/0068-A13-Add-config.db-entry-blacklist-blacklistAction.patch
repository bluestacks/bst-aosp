+    private void bstDumpInstalledBlacklistedApps() {
+        File outputFile = new File(bstBlacklistedInstalledAppListPath);
+        FileWriter fw;
+        BufferedWriter out = null;
+        try {
+            if (bstUninstallPkgList.size() == 0)
+                return;
+            if (!outputFile.exists()) {
+                outputFile.createNewFile();
+            }
+            if (FileUtils.setPermissions(bstBlacklistedInstalledAppListPath, FileUtils.S_IRUSR |
+                        FileUtils.S_IWUSR | FileUtils.S_IRGRP | FileUtils.S_IROTH, -1, -1) != 0) {
+                Slog.e(TAG, "Failed to change permissions for the file " + bstBlacklistedInstalledAppListPath);
+            }
+            fw = new FileWriter(outputFile, false);
+            out = new BufferedWriter(fw);
+            Iterator<String> it = bstUninstallPkgList.iterator();
+            while (it.hasNext()) {
+                String entry = it.next();
+                entry = entry.concat(";");
+                out.write(entry);
+            }
+            if (BST_DEBUG) Slog.i(TAG, "Data written into " + bstBlacklistedInstalledAppListPath);
+        } catch (Exception e) {
+            Slog.e(TAG, "File Access Error: Not Able to write Data into " + bstBlacklistedInstalledAppListPath);
+            if (BST_DEBUG) e.printStackTrace();
+        } finally {
+            try {
+                if (out != null) {
+                    out.close();
+                }
+                if (outputFile.length() == 0)
+                    outputFile.delete();
+            } catch (Exception e) {
+                Slog.e(TAG, "Exception in bstUninstallBlacklistedApps");
+                if (BST_DEBUG) e.printStackTrace();
+            }
+        }
+    }
+
+    public Set<String> getBstUninstallPkgList() {
+        return bstUninstallPkgList;
+    }
