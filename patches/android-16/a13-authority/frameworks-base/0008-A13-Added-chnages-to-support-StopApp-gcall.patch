@@ -2062,6 +2062,30 @@ public class ActivityTaskManagerService extends IActivityTaskManager.Stub {
         }
     }
 
+    /**
+     * @hide
+     * BST: Adding a remove task wrapper to handle requests sent via BstCommandProcessor for gcall
+     * This fixes issue of the process already killed via gcall showing up in the recent apps
+     * As the process's taskId is still in foreground, the kill signal is not sent immediately
+     * Instead ProcessRecord waitingToKill field is set and the process is queued
+     * It eventually gets killed when it goes into background
+     * In this scenario, it is possible that the process gets scheduled in a new task stack to foreground.
+     *
+     * @param: taskId - identifier of the task to be removed
+     * @param: isBstRequest - if the call is from bst specific flow ex gcall
+     */
+    public boolean removeTaskWrapper(int taskId, boolean isBstRequest) {
+        mAmInternal.enforceCallingPermission(REMOVE_TASKS, "removeTask()");
+        synchronized (this) {
+            final long ident = Binder.clearCallingIdentity();
+            try {
+                return mTaskSupervisor._removeTaskById(taskId, true, REMOVE_FROM_RECENTS, "remove-task", isBstRequest);
+            } finally {
+                Binder.restoreCallingIdentity(ident);
+            }
+        }
+    }
+
     @Override
     public void removeAllVisibleRecentTasks() {
         mAmInternal.enforceCallingPermission(REMOVE_TASKS, "removeAllVisibleRecentTasks()");
