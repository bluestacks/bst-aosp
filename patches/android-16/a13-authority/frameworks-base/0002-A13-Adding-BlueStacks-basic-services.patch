+            InputStream is = new FileInputStream(db);
+            int size = is.available();
+            byte[] buffer = new byte[size];
+            is.read(buffer);
+            is.close();
+            json = new String(buffer, "UTF-8");
+        } catch (IOException ex) {
+            Slog.e(TAG,"error in  : loadConfigDb " + ex.getMessage());
+            return null;
+        }
+        return json;
