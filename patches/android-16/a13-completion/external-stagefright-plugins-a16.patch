From 6462e1ed74e9c91b4bf336713c8f928afeb3a4fc Mon Sep 17 00:00:00 2001
From: mark-bst <zeqing.xu@bluestacks.com>
Date: Tue, 4 Aug 2026 20:32:27 +0800
Subject: [PATCH] [A16] Adapt FFmpeg Stagefright plugins for Android 16

---
 common.mk            | 3 ---
 extractor/Android.mk | 1 +
 omx/Android.mk       | 1 +
 utils/Android.mk     | 1 +
 4 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/common.mk b/common.mk
index db6610b..b7759d0 100644
--- a/common.mk
+++ b/common.mk
@@ -18,9 +18,6 @@ include $(CLEAR_VARS)
 
 include external/$(AV_CODEC_LIB)/android/$(AV_CODEC_LIB).mk
 
-# put the libraries to /vendor
-LOCAL_PROPRIETARY_MODULE := true
-
 LOCAL_C_INCLUDES += \
 	$(LOCAL_PATH)/../include \
 	$(LOCAL_PATH)/.. \
diff --git a/extractor/Android.mk b/extractor/Android.mk
index c41ece0..d68ce33 100644
--- a/extractor/Android.mk
+++ b/extractor/Android.mk
@@ -13,5 +13,6 @@ LOCAL_SHARED_LIBRARIES += \
 
 LOCAL_MODULE:= libffmpeg_extractor
 LOCAL_MODULE_RELATIVE_PATH := extractors
+LOCAL_MULTILIB := 64
 
 include $(BUILD_SHARED_LIBRARY)
diff --git a/omx/Android.mk b/omx/Android.mk
index 08cf15e..27cd0c7 100644
--- a/omx/Android.mk
+++ b/omx/Android.mk
@@ -22,5 +22,6 @@ LOCAL_SHARED_LIBRARIES += \
 	libstagefright_softomx
 
 LOCAL_MODULE:= libffmpeg_omx
+LOCAL_MULTILIB := 64
 
 include $(BUILD_SHARED_LIBRARY)
diff --git a/utils/Android.mk b/utils/Android.mk
index f370b93..3d5aba4 100644
--- a/utils/Android.mk
+++ b/utils/Android.mk
@@ -15,6 +15,7 @@ LOCAL_SHARED_LIBRARIES += \
 LOCAL_STATIC_LIBRARIES += libstagefright_metadatautils
 
 LOCAL_MODULE := libffmpeg_utils
+LOCAL_MULTILIB := 64
 
 # Workaround for inline assembly tricks in FFMPEG which don't play nice with
 # Clang when included from C++
-- 
2.34.1

