+// This function modifies the value of <field> (BRAND, MODEL, MANUFACTURER, FINGERPRINT) in Build.java class.
+static void BstSetDeviceProperties(JNIEnv* env, const char* prop_name, jclass build_class, const char* field) {
+
+    char prop_value[PROPERTY_VALUE_MAX];
+    int len = __system_property_get(prop_name, prop_value);
+    if (len == 0) {
+        ALOGW("Property %s has value null", prop_name);
+        return;
+    }
+
+    jfieldID field_id = env->GetStaticFieldID(build_class, field, "Ljava/lang/String;");
+    if (field_id == nullptr) {
+        env->ExceptionClear();
+        ALOGW("Could not find %s field.", field);
+        return;
+    }
+
+    jstring str = env->NewStringUTF(prop_value);
+    if (str == nullptr) {
+        env->ExceptionClear();
+        ALOGW("Could not create string %s.", prop_value);
+        return;
+    }
+
+    env->SetStaticObjectField(build_class, field_id, str);
+}
