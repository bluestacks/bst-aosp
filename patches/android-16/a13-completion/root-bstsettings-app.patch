diff --git a/packages/apps/BstSettings/Android.mk b/packages/apps/BstSettings/Android.mk
new file mode 100644
index 0000000..140e2f7
--- /dev/null
+++ b/packages/apps/BstSettings/Android.mk
@@ -0,0 +1,31 @@
+LOCAL_PATH:= $(call my-dir)
+include $(CLEAR_VARS)
+
+#LOCAL_JAVA_LIBRARIES := bouncycastle conscrypt telephony-common ims-common android-support-v7-appcompat android-support-v4
+#LOCAL_STATIC_JAVA_LIBRARIES := android-support-v4 android-support-v13 jsr305
+
+LOCAL_MODULE_TAGS := optional
+LOCAL_SRC_FILES := $(call all-java-files-under, src)
+
+LOCAL_RESOURCE_DIR := $(LOCAL_PATH)/res
+# For oem msi5 there is a different app icon,
+# so added different res folder 'res_msi5' to make its icon different.
+ifeq ($(OEM), msi5)
+    LOCAL_RESOURCE_DIR += $(LOCAL_PATH)/res_icon_msi5
+else
+    LOCAL_RESOURCE_DIR += $(LOCAL_PATH)/res_icon_default
+endif
+
+LOCAL_AAPT_FLAGS := --auto-add-overlay
+
+LOCAL_PACKAGE_NAME := BstSettings
+LOCAL_PACKAGE_NAME := com.bluestacks.settings
+LOCAL_CERTIFICATE := platform
+LOCAL_PRIVILEGED_MODULE := true
+LOCAL_PRIVATE_PLATFORM_APIS := true
+
+LOCAL_PROGUARD_ENABLED := disabled
+
+#include frameworks/opt/setupwizard/navigationbar/common.mk
+
+include $(BUILD_PACKAGE)
diff --git a/packages/apps/BstSettings/AndroidManifest.xml b/packages/apps/BstSettings/AndroidManifest.xml
new file mode 100644
index 0000000..806127e
--- /dev/null
+++ b/packages/apps/BstSettings/AndroidManifest.xml
@@ -0,0 +1,51 @@
+<?xml version="1.0" encoding="utf-8"?>
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    package="com.bluestacks.settings"
+    android:versionCode="69"
+    android:versionName="69.1" >
+
+    <uses-sdk android:minSdkVersion="25"
+            android:targetSdkVersion="25"/>
+
+    <queries>
+        <package android:name="com.andorid.settings" />
+        <package android:name="com.android.permissioncontroller" />
+    </queries>
+
+    <uses-permission android:name="android.permission.GET_ACCOUNTS"/>
+    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
+    <uses-permission android:name="android.permission.INTERNET"/>
+    <uses-permission android:name="android.permission.MANAGE_ROLE_HOLDERS" />
+
+    <application
+        android:icon="@mipmap/ic_launcher_settings"
+        android:label="@string/app_name"
+        android:supportsRtl="true"
+    	android:theme="@style/AppTheme">
+        <activity
+            android:name=".SettingsActivity"
+            android:label="@string/app_name"
+            android:clearTaskOnLaunch="true"
+            android:directBootAware="true">
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LAUNCHER" />
+            </intent-filter>
+        </activity>
+
+        <activity
+            android:name=".InputMethodSettings"
+            android:label="@string/input_method_settings"
+            android:icon="@drawable/ic_settings_select_ime"
+            >
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+            </intent-filter>
+        </activity>
+        <activity
+            android:name=".EnableIME"
+            android:theme="@style/ActionBarStyle"
+            >
+        </activity>
+    </application>
+</manifest>
