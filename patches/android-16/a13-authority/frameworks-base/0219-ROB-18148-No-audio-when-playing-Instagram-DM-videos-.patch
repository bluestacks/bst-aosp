+    /**
+     * When playing Instagram DM videos on Android phone, it is also silent by default.
+     * We need to manually adjust the volume key each time before you can hear any sound.
+     *
+     * Therefore, this function is designed to simulate the input of volume key event,
+     * ensuring that the sound will automatically play each time DM video is opened.
+     */
+    void setVolumeForInstagram() {
+        if (Process.myUid() >= 10000
+                && getComponentName().getPackageName().equals("com.instagram.android")
+                && getComponentName().getClassName().equals("com.instagram.modal.TransparentModalActivity")) {
+            new Thread(new Runnable() {
+                @Override
+                public void run() {
+                    int keyCode = KeyEvent.KEYCODE_VOLUME_UP;
+                    boolean restore = true;
+                    AudioManager audioManager = getSystemService(AudioManager.class);
+                    if (audioManager != null) {
+                        if (audioManager.getStreamVolume(AudioSystem.STREAM_MUSIC) == 0) {
+                            restore = false;
+                        } else if (audioManager.getStreamVolume(AudioSystem.STREAM_MUSIC) == audioManager.getStreamMaxVolume(AudioSystem.STREAM_MUSIC)) {
+                            keyCode = KeyEvent.KEYCODE_VOLUME_DOWN;
+                        }
+                    }
+
+                    mInstrumentation.sendKeyDownUpSync(keyCode);
+                    if (restore) {
+                        keyCode = (keyCode == KeyEvent.KEYCODE_VOLUME_UP) ? KeyEvent.KEYCODE_VOLUME_DOWN : KeyEvent.KEYCODE_VOLUME_UP;
+                        mInstrumentation.sendKeyDownUpSync(keyCode);
+                    }
+                }
+            }).start();
+        }
+    }
+
