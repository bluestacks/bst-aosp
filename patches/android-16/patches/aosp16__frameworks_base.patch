+/**
+ * @brief Set one bit
+ */
+static inline void SetBit( unsigned char* data, int idxBit )
+{
+    int n = idxBit/8;
+    int m = idxBit%8;
+    data[n] = data[n] | (1<<m);
+}
+
+/**
+ * @brief Check whether one bit is set
+ */
+static inline bool IsBitSet( unsigned char* data, int idxBit )
+{
+    int n = idxBit/8;
+    int m = idxBit%8;
+    return !!( data[n] & (1<<m) );
+}
+
+/**
