+
+static int       g_wl_uids[MAX_WL_UIDS];
+static size_t    g_wl_uids_cnt = 0;
+
+static wl_pkg_t  g_wl_pkgs[MAX_WL_PKGS];
+static size_t    g_wl_pkgs_cnt = 0;
+
+static char      g_wl_execdirs[MAX_WL_DIRS][PATH_MAX];
