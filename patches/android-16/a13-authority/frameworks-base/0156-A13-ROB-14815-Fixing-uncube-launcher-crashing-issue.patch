             if (abis.secondary != null) {
                 secondaryNativeLibraryDir = new File(nativeLibraryRootDir,
@@ -324,7 +335,7 @@ final class PackageAbiHelperImpl implements PackageAbiHelper {
                 new Abis(pkgRawPrimaryCpuAbi, pkgRawSecondaryCpuAbi),
