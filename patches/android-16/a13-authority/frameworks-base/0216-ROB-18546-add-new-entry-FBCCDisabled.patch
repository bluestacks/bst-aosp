 .../bluestacks/os/BstFilterAppsManager.java   | 27 ++++++++++
 .../bluestacks/os/IBstFilterAppsService.aidl  |  1 +
 .../server/BstFilterAppsService.java          | 49 +++++++++++++++++++
 3 files changed, 77 insertions(+)

diff --git a/core/java/com/bluestacks/os/BstFilterAppsManager.java b/core/java/com/bluestacks/os/BstFilterAppsManager.java
index 7757b53fee8c..8529c0886120 100755
--- a/core/java/com/bluestacks/os/BstFilterAppsManager.java
+++ b/core/java/com/bluestacks/os/BstFilterAppsManager.java
@@ -2013,4 +2013,31 @@ public class BstFilterAppsManager {
             return false;
         }
     }
+
+    /**
+     * @hide
+     */
+    public boolean isFbCompleteCheckDisabled(String pkgName)
+    {
+        if (DEBUG) Slog.d(TAG, "Trying to look for " + pkgName + " in mFbCompleteCheckDisabledAppList app list\n");
+        initLists();
+
+        synchronized (mFbCompleteCheckDisabledAppList)
+        {
+            if (mFbCompleteCheckDisabledAppList.contains(pkgName))
+            {
+                return true;
+            }
+            else
+            {
+                String wildcardMatchedPackageName = isPackageMatchedWilcard(mFbCompleteCheckDisabledAppList, pkgName);
+                if(wildcardMatchedPackageName != null)
+                {
+                    if (DEBUG) Slog.d(TAG, pkgName + " is in isFbCompleteCheckDisabled App List\n");
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
 }
