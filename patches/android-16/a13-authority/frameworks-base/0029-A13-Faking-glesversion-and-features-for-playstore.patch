+         // show gl version based on .config.db
+        int pid = Binder.getCallingPid();
+        int uid = Binder.getCallingUid();
+        BstFilterAppsManager mBstFilterApps = null;
+
+        if (uid < 10000) {
+            return config;
+        }
+        if (mBstFilterApps == null) {
+            mBstFilterApps = (BstFilterAppsManager) mContext.getSystemService(Context.BST_FILTER_APPS);
+        }
+
+        String pkgName = BstUtils.getAppNameFromPid(pid);
+        int glVersion = mBstFilterApps.getGlVersion(pkgName);
+        if (glVersion != -1) {
+            config.reqGlEsVersion = glVersion;
+        }
+
         return config;
     }
 
