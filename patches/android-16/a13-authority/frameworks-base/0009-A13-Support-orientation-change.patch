+    /* This function is used to change DPI value of portrait apps at runtime. */
+    private void changeDisplayDensity(int density) {
+         boolean isCustomDpiApp = false;
+         String topPackageName = android.os.SystemProperties.get("bst.config.top_package_name", null);
+         isCustomDpiApp = mBstFilterApps.isCustomDpiApp(topPackageName);
+
+         if (!isCustomDpiApp && density > 0)
+         {
+             Slog.i(TAG, "Not Changing default density value for app : " + topPackageName + " isCustomDpiApp: " + isCustomDpiApp + " density : " + density);
+             return;
+         }
+
+         if (density > 0 && (density < 120 || density > 320)) {
+             Slog.i(TAG, "Invalid density value : " + density);
+             return;
+         }
+
+         try {
+             int initialDensity = getInitialDisplayDensity(Display.DEFAULT_DISPLAY);
+             int currDensity = getBaseDisplayDensity(Display.DEFAULT_DISPLAY);
+
+            /*
+             if (BST_DEBUG_ORIENTATION)
+                Slog.d(TAG, "initialDensity = " + initialDensity + " currDensity = " + currDensity + " requested density = " + density);
+            */
+
+             if (density < 0 && initialDensity != currDensity)
+             {
+                 Slog.i(TAG, "resetting default display density");
+                 clearForcedDisplayDensityForUser(Display.DEFAULT_DISPLAY, UserHandle.USER_CURRENT);
+             }
+             else if (density > 0 && currDensity != density)
+             {
+                 Slog.i(TAG, "setting density from " + currDensity + " to " + density);
+                 setForcedDisplayDensityForUser(Display.DEFAULT_DISPLAY, density, UserHandle.USER_CURRENT);
+             }
+         } catch (Exception e) {
+             Slog.i(TAG, "Exception in changing setting density to " + density);
+             e.printStackTrace();
+         }
+     }
+
+    /**
+     * Send Orientation update to HOST
+     */
+    public void sendOrientationToHostAsync(final int rotation) {
+        try {
+
+            Slog.d(TAG, "sendOrientationToHostAsync: calling BstHostCallManagerService onOrientationChange method, orientation: " + rotation);
+            int rval = mBstHostCallManagerService.onOrientationChange(rotation);
+            Slog.d(TAG, "sendOrientationToHostAsync: BstHostCallManagerService onOrientationChange method returned: " + rval);
+            if (rval != 0) {
+                Slog.i(TAG, "Failed to send Host Orientation request -- WindowsFrontend: " + rval);
+            } else {
+                //TODO: Need to handle dpi only for portrait mode apps.
+                /*
+                if (rotation == Surface.ROTATION_90 || rotation == Surface.ROTATION_270) {
+                    int initialDensity = getInitialDisplayDensity(Display.DEFAULT_DISPLAY);
+                    if (initialDensity <= 192) {
+                        // Portrait app on mdpi, change system DPI to 240 for better readability
+                        changeDisplayDensity(240);
+                    }
+                } else {
+                    // Switching back to Landscape app, resetting DPI value
+                    changeDisplayDensity(-1);
+                }
+                */
+            }
+        } catch (Exception exc) {
+            Log.e(TAG, "Cannot send orientation to host: " + exc.getMessage());
+            exc.printStackTrace();
+        }
+        return;
     }
 
