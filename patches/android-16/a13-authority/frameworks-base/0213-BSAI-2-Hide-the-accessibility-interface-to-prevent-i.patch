+    /**
+     * Check if the current caller is a third-party application
+     */
+    private boolean isThirdPartyCaller() {
+        final int callingUid = Binder.getCallingUid();
+        
+        // If UID is in system range, not third-party
+        if (callingUid < Process.FIRST_APPLICATION_UID) {
+            return false;
+        }
+        
+        return true;
+    }
+
+    /**
+     * Filter out hidden accessibility services from the list
+     * This method hides specified services from third-party applications
+     */
+    private List<AccessibilityServiceInfo> filterHiddenServices(List<AccessibilityServiceInfo> services) {
+        if (services == null || services.isEmpty()) {
+            return services;
+        }
+
+        // Log filter call for debugging
+        int callingUid = Binder.getCallingUid();
+        String callerInfo = "UID: " + callingUid;
+        
+        // If caller is not third-party, return original list
+        if (!isThirdPartyCaller()) {
+            if (DEBUG) {
+                Log.d(LOG_TAG, "filterHiddenServices: system caller detected, skipping filter for " + callerInfo);
+            }
+            return services;
+        }
+
+        // Define services to hide from third-party apps
+        final java.util.Set<String> hiddenServices = new java.util.HashSet<>();
+        hiddenServices.add("com.bluestacks.home/com.bluestacks.svc.services.GPAccessibilityService");
+        hiddenServices.add("com.bluestacks.BstCommandProcessor/.UiAccessibilityService");
+        hiddenServices.add("com.bluestacks.BstCommandProcessor/com.bluestacks.BstCommandProcessor.UiAccessibilityService");
+        
+        if (DEBUG) {
+            Log.d(LOG_TAG, "filterHiddenServices: filtering for third-party caller " + callerInfo + 
+               ", input count: " + services.size());
+        }
+
+        List<AccessibilityServiceInfo> filteredServices = new ArrayList<>();
+        int filteredCount = 0;
+        
+        for (AccessibilityServiceInfo service : services) {
+            ComponentName componentName = new ComponentName(
+                service.getResolveInfo().serviceInfo.packageName,
+                service.getResolveInfo().serviceInfo.name
+            );
+            
+            String serviceKey = componentName.flattenToShortString();
+            
+            // Only add service if it's not in the hidden list
+            if (!hiddenServices.contains(serviceKey)) {
+                filteredServices.add(service);
+            } else {
+                if (DEBUG) {
+                    Log.i(LOG_TAG, "Hiding accessibility service from third-party caller: " + serviceKey + 
+                       " for " + callerInfo);
+                }
+                filteredCount++;
+            }
+        }
+        
+        if (DEBUG) {
+            Log.d(LOG_TAG, "filterHiddenServices: filtered " + filteredCount + 
+                   " services, remaining: " + filteredServices.size() + " for " + callerInfo);
+        }
+
+        return filteredServices;
+    }
+
