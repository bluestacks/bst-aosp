+    private static volatile boolean isLockScreen = false;
+    private static volatile int sLockScreenOrientation = SCREEN_ORIENTATION_LANDSCAPE;
+    int getBstOrientation(int req) {
+        int bstOrientationValue = req;
+
+        String topPackageName = android.os.SystemProperties.get("bst.config.top_package_name", null);
+        if ("com.foxnextgames.m3".equals(topPackageName)) {
+            return SCREEN_ORIENTATION_UNSPECIFIED ;
+        }
+
+        // Whatsapp reply interface is set to portrait so that the input box can be displayed normally
+        String topActivityName = android.os.SystemProperties.get("bst.config.top_activity_name", null);
+        if ("com.whatsapp/.status.playback.StatusReplyActivity".equals(topActivityName)) {
+            return SCREEN_ORIENTATION_PORTRAIT;
+        }
+
+        // ROB-12002 When the game starts Facebook login, the screen orientation of the Facebook login interface is consistent with the screen orientation of the game.
+        String callingPackage = android.os.SystemProperties.get("bst.config.calling_package", "null");
+        boolean fbscreenlock = mBstFilterApps.isFbScreenLockApp(callingPackage);
+        if (!"com.facebook.katana".equals(topPackageName) && !"com.google.android.gms/.auth.api.credentials.ui.CredentialPickerActivity".equals(topActivityName)) isLockScreen = false;
+        if ((isLockScreen || fbscreenlock) && ("com.facebook.katana".equals(topPackageName) || "com.google.android.gms/.auth.api.credentials.ui.CredentialPickerActivity".equals(topActivityName))) {
+            if (!isLockScreen) {
+                isLockScreen = true;
+                sLockScreenOrientation = getBstOrientationImp2(req);
+            }
+
+            return sLockScreenOrientation;
+        }
+
+        bstOrientationValue = getBstOrientationImp(req);
+
+        return bstOrientationValue;
+    }
