+    public int bstHandleProprietryIntents(@Nullable Context who, int result, @Nullable Intent intent) {
+        try {
+            /* Changes to handle market:// and other such proprietry intent from the applications. Now, for such intents,
+             * show a Toast message and return Intent successfully handled to the application, since Bluestacks don't
+             * have google android market or such proprietry apps installed on their device by default. This is needed as
+             * some poorly written application don't handle the cases if we provide them with actual errors and hence result
+             * into the crash.
+             */
+            if (who == null || intent == null )
+                return result ;
+
+            String data = "";
+            if (intent.getData() != null)
+                data = intent.getData().toString().toLowerCase();
+            ComponentName mComponent = intent.getComponent();
+            Log.w(TAG, "Unresolved intent: cmp: " + mComponent);
+            Log.w(TAG, "Unresolved intent: data: " + data);
+            if (data.startsWith("market:"))
+            {
+                result = ActivityManager.START_SUCCESS;
+                Toast toast = Toast.makeText(who, "Sorry, this feature is not supported currently", Toast.LENGTH_LONG);
+                toast.setGravity(Gravity.BOTTOM, 0, 0);
+                toast.show();
+            }
+            else if (data.startsWith("mailto:"))
+            {
+                result = ActivityManager.START_SUCCESS;
+                Toast toast = Toast.makeText(who, "This app requires an Email app to send e-mail. Please install one and retry this.", Toast.LENGTH_LONG);
+                toast.setGravity(Gravity.BOTTOM, 0, 0);
+                toast.show();
+            }
+            else if (mComponent != null) {
+                String mComponentName = mComponent.flattenToShortString();
+                Log.w(TAG, "Unresolved intent: cmpName: " + mComponentName);
+                if (mComponentName.startsWith("com.google.android.gm") && !mComponentName.endsWith(".Main"))
+                {
+                    result = ActivityManager.START_SUCCESS;
+                    Toast toast = Toast.makeText(who, "This app requires GMail. Please install the GMail app and retry this.", Toast.LENGTH_LONG);
+                    toast.setGravity(Gravity.BOTTOM, 0, 0);
+                    toast.show();
+                }
+                else if (mComponentName.startsWith("com.google.android.apps.maps") && !mComponentName.endsWith(".Main"))
+                {
+                    result = ActivityManager.START_SUCCESS;
+                    Toast toast = Toast.makeText(who, "This app requires Google Maps. Please install the Google Maps app and retry this.", Toast.LENGTH_LONG);
+                    toast.setGravity(Gravity.BOTTOM, 0, 0);
+                    toast.show();
+                }
+                else if (mComponentName.startsWith("com.google.android.youtube") && !mComponentName.endsWith(".Main"))
+                {
+                    result = ActivityManager.START_SUCCESS;
+                    Toast toast = Toast.makeText(who, "This app requires YouTube. Please install the YouTube app and retry this.", Toast.LENGTH_LONG);
+                    toast.setGravity(Gravity.BOTTOM, 0, 0);
+                    toast.show();
+                }
+                else if (mComponentName.startsWith("com.google.android.voicesearch") && !mComponentName.endsWith(".Main"))
+                {
+                    result = ActivityManager.START_SUCCESS;
+                    Toast toast = Toast.makeText(who, "This app requires Voice Search. Please install the Voice Search app and retry this.", Toast.LENGTH_LONG);
+                    toast.setGravity(Gravity.BOTTOM, 0, 0);
+                    toast.show();
+                }
+                else if (mComponentName.startsWith("com.android.vending") && !mComponentName.endsWith(".Main"))
+                {
+                    result = ActivityManager.START_SUCCESS;
+                    Toast toast = Toast.makeText(who, "Sorry, this feature is not supported currently", Toast.LENGTH_LONG);
+                    toast.setGravity(Gravity.BOTTOM, 0, 0);
+                    toast.show();
+                }
+            }
+        } catch (Exception ex) {
+            Log.w(TAG, "Exception occured while handling intent");
+            ex.printStackTrace();
+            //ignore it
+        }
+        return result;
+    }
