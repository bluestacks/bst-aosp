+    /**
+     * This method handles IME related changes for special apps defined in
+     * softkeyboard_activity file or when switching from a special app
+     * To check if softkeyboard should be shown we use isSoftKeyboardRequired
+     * method of BstUtilsManager.
+     * */
+    private void handleIMEForSpecialApps(String packageName, String activityName, String callingPackage) {
+        // Firstly check if this is one of those activities for which we need to disable the
+        // hard keyboard irrespective of original settings. If that is not the case, check
+        // whether this is the first activity change after setting the soft keyboard, if so
+        // restore the original hard keyboard setting.
+        BstFilterAppsManager bstfilter = (BstFilterAppsManager) mService.mContext.getSystemService(Context.BST_FILTER_APPS);
+        BstUtilsManager bstUtils = (BstUtilsManager) mService.mContext.getSystemService(Context.BST_UTILS);
+
+        boolean usePhysicalKeyboard = false;
+        boolean isSoftKeyboardRequired = false;
+        String softKeyboardModifier = "soft";
+
+        // handling for isSoftKeyboardModifier, as if callingPackageName  is valid and require softkeyboard then we force current PackageName to use softkeyboard, this fixes BS4-2693: com.netmarble.bnsmkr--as this app requires soft entry and it opens chrome for faceboook login , but after returning from chrome its facebookActivity recreate due to change in configuration of keyboard
+        // these changes fix this issue as we maintain same keyboard configuration(soft) for this app and for the app that opens through it too
+        if (callingPackage != null && callingPackage.trim().length() > 0 && !callingPackage.equalsIgnoreCase(mPreviousCallingPackage) && !packageName.equalsIgnoreCase(callingPackage)) {
+            mPreviousCallingPackage = callingPackage;
+        }
+
+        isSoftKeyboardRequired = bstfilter.isSoftKeyboardRequired(packageName, activityName) || bstfilter.isSoftKeyboardRequired(mPreviousCallingPackage, activityName);
+        if (isSoftKeyboardRequired)
+            softKeyboardModifier = bstfilter.getSoftKeyboardModifier(packageName);
+
+        boolean isShowImeWithHardKeyboardEnabled = false;
+        isShowImeWithHardKeyboardEnabled = bstUtils.isBstSoftKeyboardEnabled();
+
+        if (isSoftKeyboardRequired) {
+            String id = Settings.Secure.getString(mService.mContext.getContentResolver(), Settings.Secure.DEFAULT_INPUT_METHOD);
+
+            if (id != null && id.equals("com.android.inputmethod.latin/.LatinIME") &&
+                    (softKeyboardModifier.equals("hard") || softKeyboardModifier.equals("pass"))) {
+                Slog.d(TAG, "TopActivityInfo, pkgName: " + packageName + " activityName: " + activityName + " modifier is hard/pass in softkeyboard file and ime is LatinIME so not enabling soft keyboard");
+                // In gamemanager this can happen as we can switch from a package for which softkeyboard was enabled
+                // to a package for which we had "hard/pass" entry in softkeyboard_activity.db file
+                // if soft keyboard was already enabled, disabling it
+                if (isShowImeWithHardKeyboardEnabled) {
+                    Slog.d(TAG, "TopActivityInfo, pkgName: " + packageName + " activityName: " + activityName + " softKeyboard was enabled so disabling it");
+                    usePhysicalKeyboard = true;
+                    bstUtils.setBstSoftKeyboardStatus(!usePhysicalKeyboard);
+                    bstSpecialAppKeyboardHandlingEnabled = false;
+                }
+            } else if (!isShowImeWithHardKeyboardEnabled) {
+                // This is one of the special app. Disable hard keyboard if its currently enabled
+                usePhysicalKeyboard = false;
+                bstUtils.setBstSoftKeyboardStatus(!usePhysicalKeyboard);
+                bstSpecialAppKeyboardHandlingEnabled = true;
+                Slog.d(TAG, "TopActivityInfo, pkgName: " + packageName + " activityName: " + activityName + " disabling hard keyboard - in special apps list");
+            }
+        } else if (bstSpecialAppKeyboardHandlingEnabled && isShowImeWithHardKeyboardEnabled) {
+            // This is the first activity after setting the soft keyboard forcefully for specific filtered apps,
+            // so restoring the original hard keyboard settings value.
+            usePhysicalKeyboard = true;
+            bstUtils.setBstSoftKeyboardStatus(!usePhysicalKeyboard);
+            bstSpecialAppKeyboardHandlingEnabled = false;
+            Slog.d(TAG, "TopActivityInfo, pkgName: " + packageName + " activityName: " + activityName + " enabling hard keyboard as moved away from special apps list");
+        }
+    }
+
+    /**
+     * @hide
+     */
+    public void bstOnDisplayedPackageChange(String packageName, String activityName, String callingPackage) {
+        //1. Send current top Activity info to WindowsAgent and set soft/hard keyboard status according to app setting.
+        handleIMEForSpecialApps(packageName, activityName, callingPackage);
+
+        Slog.d(TAG, "TopActivityInfo, pkgName: " + packageName
+                    + " activityName: " + activityName
+                    + " callingPackage: " + callingPackage
+                    + " bstSpecialAppKeyboardHandling Enabled = " + bstSpecialAppKeyboardHandlingEnabled);
+
+        String trimmedPackageName = packageName;
+        String trimmedActivityName = activityName;
+        String trimmedCallingPackageName = callingPackage;
+
+        if (packageName.length() > SystemProperties.PROP_VALUE_MAX)
+            trimmedPackageName = packageName.substring(0,SystemProperties.PROP_VALUE_MAX);
+        if (activityName.length() > SystemProperties.PROP_VALUE_MAX)
+            trimmedActivityName = activityName.substring(0,SystemProperties.PROP_VALUE_MAX);
+        if (callingPackage != null && callingPackage.length() > SystemProperties.PROP_VALUE_MAX)
+            trimmedCallingPackageName = callingPackage.substring(0,SystemProperties.PROP_VALUE_MAX);
+
+        //2. Set topPackageName and topActivityName
+        SystemProperties.set("bst.config.top_package_name", trimmedPackageName);
+        SystemProperties.set("bst.config.top_activity_name", trimmedActivityName);
+
+        //3. Set callingPackage
+        String previousCallingPackageName = SystemProperties.get("bst.config.calling_package", null);
+        if (trimmedCallingPackageName != null && !trimmedCallingPackageName.isEmpty() && !trimmedCallingPackageName.equals(previousCallingPackageName)) {
+            SystemProperties.set("bst.config.calling_package", trimmedCallingPackageName);
+        }
+
+        //4. Checks if package requires headset property to be modified.
+        bstSendHeadsetIntent(packageName);
+        return;
+    }
+
+    // Checks if Package requires headset property to be modified.
+    private void bstSendHeadsetIntent(String pkgName) {
+        if (pkgName == null || pkgName.isEmpty())
+            return;
+
+        BstFilterAppsManager bstfilter = (BstFilterAppsManager) mService.mContext.getSystemService(Context.BST_FILTER_APPS);
+        boolean pluggedin = bstfilter.isHeadsetRequired(pkgName);
+        int state = 0;  //0 for unplugged, 1 for plugged.
+        int microphone = 0; //1 if headset has a microphone, 0 otherwise
+        if (pluggedin != currHeadsetState) {
+            //  Pack up the values and broadcast them to everyone
+            Intent intent = new Intent(Intent.ACTION_HEADSET_PLUG);
+            intent.addFlags(Intent.FLAG_RECEIVER_REGISTERED_ONLY);
+
+            if (pluggedin) {
+                state = 1;
+                microphone = 1;
+            }
+
+            intent.putExtra("state", state);
+            intent.putExtra("name", "BlueStacks"); //Headset type, human readable string
+            intent.putExtra("microphone", microphone);
+
+            Slog.d(TAG, "Sending broadcastStickyIntent ACTION_HEADSET_PLUG: state: " + state + " mic: " + microphone + " pkgName : " + pkgName);
+            ActivityManagerNative.broadcastStickyIntent(intent, null, UserHandle.myUserId());
+            currHeadsetState = pluggedin;
+        }
+    }
