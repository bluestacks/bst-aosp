+bool EmuHWC2::Display::VsyncThread::syncBstMaxFpsLocked() {
+    char value[PROPERTY_VALUE_MAX] = {};
+    property_get("bst.max_fps", value, "0");
+    const long maxFps = std::strtol(value, nullptr, 10);
+    if (maxFps <= 0 || maxFps > 240) {
+        return false;
+    }
+
+    const uint32_t refreshPeriod = static_cast<uint32_t>(1000000000LL / maxFps);
+    if (refreshPeriod == 0 || refreshPeriod == mDisplay.mVsyncPeriod) {
+        return false;
+    }
+
+    mDisplay.mVsyncPeriod = refreshPeriod;
+    if (mDisplay.mActiveConfig) {
+        const auto configId = mDisplay.mActiveConfig->getId();
+        if (configId < mDisplay.mConfigs.size()) {
+            mDisplay.mConfigs[configId]->setAttribute(
+                    Attribute::VsyncPeriod, static_cast<int32_t>(refreshPeriod));
+        }
+    }
+    ALOGI("bst.max_fps=%ld changed vsync period to %u ns", maxFps, refreshPeriod);
+    return true;
+}
+
+void EmuHWC2::Display::VsyncThread::updateWaitTimeLocked(struct timespec* waitTime) const {
+    const uint64_t period = mDisplay.mVsyncPeriod;
+    waitTime->tv_sec = static_cast<time_t>(period / 1000000000ULL);
+    waitTime->tv_nsec = static_cast<long>(period % 1000000000ULL);
+}
+#endif
