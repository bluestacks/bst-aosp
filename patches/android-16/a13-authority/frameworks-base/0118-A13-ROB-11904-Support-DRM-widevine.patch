diff --git a/core/java/com/bluestacks/os/BstFilterAppsManager.java b/core/java/com/bluestacks/os/BstFilterAppsManager.java
index 2fa35437af39..9566f79fd3bd 100755
--- a/core/java/com/bluestacks/os/BstFilterAppsManager.java
+++ b/core/java/com/bluestacks/os/BstFilterAppsManager.java
@@ -1648,4 +1648,20 @@ public class BstFilterAppsManager {
             return false;
         }
     }
+
+    /**
+     * @hide
+     */
+    public boolean isDrmEnabled(String pkgName)
+    {
+        try {
+            return mService.isDrmEnabled(pkgName);
+        } catch(Exception e) {
+            // Catching the error and returning default behavior as if entry was not
+            // present in config.db
+            if (DEBUG) e.printStackTrace();
+            return false;
+        }
+    }
+
 }
