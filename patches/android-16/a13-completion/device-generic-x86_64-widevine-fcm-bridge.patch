From 00623898eb9bd0afc4374f6c79f805939f873311 Mon Sep 17 00:00:00 2001
From: mark-bst <zeqing.xu@bluestacks.com>
Date: Wed, 5 Aug 2026 07:18:48 +0800
Subject: [PATCH] [A16] Declare Widevine HIDL FCM bridge

---
 framework_compatibility_matrix.xml | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/framework_compatibility_matrix.xml b/framework_compatibility_matrix.xml
index 969cfa3..2fc6a20 100644
--- a/framework_compatibility_matrix.xml
+++ b/framework_compatibility_matrix.xml
@@ -1,4 +1,19 @@
 <compatibility-matrix version="1.0" type="framework" level="8">
+    <!-- Android 16 compatibility bridges for validated Windows guest HALs. -->
+    <!-- Widevine retains the A13-validated HIDL service until its vendor plugin
+         is available behind the Android 16 AIDL DRM interface. -->
+    <hal format="hidl" optional="true">
+        <name>android.hardware.drm</name>
+        <version>1.3</version>
+        <interface>
+            <name>ICryptoFactory</name>
+            <instance>widevine</instance>
+        </interface>
+        <interface>
+            <name>IDrmFactory</name>
+            <instance>widevine</instance>
+        </interface>
+    </hal>
     <!-- The Windows renderer still uses the validated goldfish HIDL stack. -->
     <hal format="hidl" optional="true">
         <name>android.hardware.graphics.allocator</name>
-- 
2.34.1

