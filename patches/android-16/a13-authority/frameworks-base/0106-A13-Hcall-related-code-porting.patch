+    // This function will check if the app is opened from some third party app through some ad.
+    // If referrer field is present then we will not send our click event
+    // and will let the conversion attributed to the click event sent by the third party app.
+    /*
+     *@hide
+     */
+    public void bstReferrerHack(@Nullable Context context, @Nullable Intent mIntent) {
+        String intentData = mIntent.getDataString();
+        if (BST_DBG_REFERRAL) Log.d(BST_TAG_REFERRAL, "intentData = " + intentData);
+        if (context != null && mIntent != null && intentData != null
+                && (intentData.startsWith("https://play.google.com/store/apps/details")
+                    || intentData.startsWith("http://play.google.com/store/apps/details")
+                    || intentData.startsWith("https://market.android.com/details")
+                    || intentData.startsWith("http://market.android.com/details")
+                    || intentData.startsWith("market://details"))) {
+            String values = intentData.substring(intentData.indexOf("?") + 1);
+            String keyValuePairs[] = values.split("&");
+            String packageName = null;
+            String referrer = null;
+            String value = "";
+            String key = "";
+            for (String str : keyValuePairs) {
+                try {
+                    String keyValue[] = str.split("=");
+                    key = keyValue[0];
+                    if (keyValue.length > 1)
+                        value = keyValue[1];
+                    if (key.equals("id"))
+                        packageName = value;
+                    else if (key.equals("referrer"))
+                        referrer = value;
+                } catch (Exception e) {
+                    Log.e(BST_TAG_REFERRAL, "Exception while parsing the string = " + str + " key = " + key + " value = " + value);
+                    if (BST_DBG_REFERRAL) e.printStackTrace();
+                }
+            }
+            if (BST_DBG_REFERRAL) Log.d(BST_TAG_REFERRAL, "packageName = " + packageName + ", referrer = " + referrer);
+            try {
+                Intent intent = new Intent();
+                if (referrer != null) {
+                    // If referrer field is non null then we assume that the app is opened from some 3rd party app.
+                    // In this case we will not send our click event.
+                    BstUtilsManager bstutils = (BstUtilsManager) context.getSystemService(context.BST_UTILS);
+                    bstutils.setProperty("bst.config.referrerpackage", packageName);
+                    intent.setAction("BST_UPDATE_REFERRERLIST_ADD");
+                    if (BST_DBG_REFERRAL) Log.d(BST_TAG_REFERRAL, "send BST_UPDATE_REFERRERLIST_ADD to BstCommandProcessor");
+                } else {
+                    // Removing the entry from the file so that we can send our click event.
+                    intent.setAction("BST_UPDATE_REFERRERLIST_REMOVE");
+                    if (BST_DBG_REFERRAL) Log.d(BST_TAG_REFERRAL, "send BST_UPDATE_REFERRERLIST_REMOVE to BstCommandProcessor");
+                }
+                ComponentName cn = new ComponentName("com.bluestacks.BstCommandProcessor",
+                        "com.bluestacks.BstCommandProcessor.BstCommandProcessorService");
+                intent.setComponent(cn);
+                intent.putExtra("packageName", packageName);
+                context.startService(intent);
+            } catch (Exception ex) {
+                Log.w(BST_TAG_REFERRAL, "Exception while updating thirdParty Referrer List: " + ex.getMessage());
+                if (BST_DBG_REFERRAL) ex.printStackTrace();
+            }
+        }
+    }
+
+    private Intent checkIfLaunchingGpStore(Context cxt, Intent intent) {
+        Intent ret = null;
+        String intentData = intent.getDataString();
+        String callerPkgName = cxt.getBasePackageName();
+
+        if (intentData == null )
+            return ret ;
+
+        if (intentData != null
+                && (intentData.startsWith("https://play.google.com/store/apps/details")
+                    || intentData.startsWith("http://play.google.com/store/apps/details")
+                    || intentData.startsWith("https://market.android.com/details")
+                    || intentData.startsWith("http://market.android.com/details")
+                    || intentData.startsWith("market://details"))) {
+            String calleePkgName = parsePkgName(intentData);
+            if (BST_DBG) Log.d(BST_TAG, "callerPkgName = " + callerPkgName + ", calleePkgName = " + calleePkgName);
+            if (callerPkgName != null && calleePkgName!= null && callerPkgName.equalsIgnoreCase(calleePkgName))
+                ret = intent ;
+       } else if (intentData.startsWith("https://ffgpdownload.freefiremobile.com/api/link") && (callerPkgName.equalsIgnoreCase("com.dts.freefiremax"))) {
+           ret = new Intent();
+           ret.setAction("android.intent.action.VIEW");
+           ret.setData(Uri.parse("market://details?id="+callerPkgName));
+       }
+       return ret;
+    }
+
+    private String parsePkgName(String data) {
+        String values = data.substring(data.indexOf("?") + 1);
+        String keyValuePairs[] = values.split("&");
+        String packageName = null;
+        String referrer = null;
+        String value = "";
+        String key = "";
+        for (String str : keyValuePairs) {
+            try {
+                String keyValue[] = str.split("=");
+                key = keyValue[0];
+                if (keyValue.length > 1)
+                    value = keyValue[1];
+                if (key.equals("id"))
+                    packageName = value;
+            } catch (Exception e) {
+                  Log.e(BST_TAG, "Exception while parsing the string = " + str + " key = " + key + " value = " + value);
+                  if (BST_DBG) e.printStackTrace();
+            }
+        }
+        return packageName;
+    }
+
+    private String getApkUpdateSource(Context cxt, Intent intent) {
+        String response = null;
+        String intentData = intent.getDataString();
+        String calleePkgName = parsePkgName(intentData);
+        BstUtilsManager bstutils = (BstUtilsManager) cxt.getSystemService(cxt.BST_UTILS);
+        String source = bstutils.getApkDownloadSource(calleePkgName,"update");
+        String appStore = "";
+        if (source != null && source.trim().length() > 0) {
+            try {
+                JSONObject jsonObject = new JSONObject(source);
+                appStore = jsonObject.optString("app_store");
+            } catch (Exception ex) {
+                Log.e(BST_TAG, "Exception in launchAppStoreClbk : " + ex.getMessage());
+                if (BST_DBG) ex.printStackTrace();
+                return response;
+            }
+        } else {
+           if (BST_DBG) Log.e(BST_TAG, "Cloud call response is either null or empty. response : "+response);
+            return response;
+        }
+        if (appStore != null && !appStore.equals("com.android.vending")) {
+            response = source;
+        }
+        return response;
+    }
+
+    private void launchAppStore(Context cxt, Intent intent, String apkUpdateSource) {
+        String calleePkgName = parsePkgName(intent.getDataString());
+        BstUtilsManager bstutils = (BstUtilsManager) cxt.getSystemService(cxt.BST_UTILS);
+        bstutils.launchAppStore(calleePkgName, apkUpdateSource);
+    }
+
+    private boolean isLaunchingNonGpAppStore(Context who, Intent intent) {
+        boolean ret = false;
+        Intent res = checkIfLaunchingGpStore(who, intent);
+        if (res != null) {
+            String apkUpdateSource = getApkUpdateSource(who, res);
+            if (apkUpdateSource != null) {
+                launchAppStore(who, res, apkUpdateSource);
+                ret = true;
+            }
+        }
+        return ret;
+    }
+
+    /* Main function to determine whether this intent needs to be forwarded to host or not.
+     * If this intent is forwarded to host, return true else false
+     */
+    private boolean fwdIntentToHost(Context context, Intent intent) {
+        // check if extra is present in intent
+        if (!intent.getBooleanExtra("openOnHostBrowser", false)) {
+            return false;
+        }
+        Uri data = intent.getData();
+        String dataStr = "";
+        if (data != null) {
+            dataStr = data.toString();
+        } else {
+            return true;
+        }
+        if(BST_DBG) Log.d(BST_TAG, "browser intent data: " + dataStr);
+        BstHostCallManager bstHostCallManagerService = (BstHostCallManager) context.getSystemService(Context.BST_HOST_CALL);
+        bstHostCallManagerService.openUrl(dataStr);
+        return true;
+    }
