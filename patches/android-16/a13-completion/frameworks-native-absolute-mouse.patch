+TEST_F(CursorInputMapperUnitTest, ProcessAbsoluteMouseCoordinates) {
+    setupAxis(ABS_X, true, 0, DISPLAY_WIDTH - 1, /*resolution=*/1);
+    setupAxis(ABS_Y, true, 0, DISPLAY_HEIGHT - 1, /*resolution=*/1);
