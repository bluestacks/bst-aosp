+    int getBstOrientation(int req) {
+        int bstOrientationValue = req;
+        String topPackageName = android.os.SystemProperties.get("bst.config.top_package_name", null);
+        if ("com.foxnextgames.m3".equals(topPackageName)) {
+            return SCREEN_ORIENTATION_UNSPECIFIED ;
+        }
+
+        //Whatsapp reply interface is set to portrait so that the input box can be displayed normally
+        String topActivityName = android.os.SystemProperties.get("bst.config.top_activity_name",null);
+        if ("com.whatsapp/.status.playback.StatusReplyActivity".equals(topActivityName)) {
+            return SCREEN_ORIENTATION_PORTRAIT;
+        }
+        if (mBstFilterApps.isSmallScreenApp(topPackageName)) {
+            //config: small (forcing protrait mode)
+            bstOrientationValue = SCREEN_ORIENTATION_PORTRAIT;
+        } else if (mBstFilterApps.isPortraitDisabled(topPackageName)) {
+            //config: full (forcing landscape mode)
+            bstOrientationValue = SCREEN_ORIENTATION_LANDSCAPE;
+        } else if (req == SCREEN_ORIENTATION_SENSOR_LANDSCAPE
+                || req == SCREEN_ORIENTATION_USER_LANDSCAPE
+                || req == SCREEN_ORIENTATION_REVERSE_LANDSCAPE) {
+            bstOrientationValue = SCREEN_ORIENTATION_LANDSCAPE;
+        } else if (req == SCREEN_ORIENTATION_SENSOR_PORTRAIT
+                || req == SCREEN_ORIENTATION_USER_PORTRAIT
+                || req == SCREEN_ORIENTATION_REVERSE_PORTRAIT) {
+            bstOrientationValue = SCREEN_ORIENTATION_PORTRAIT;
+        } else if (req == SCREEN_ORIENTATION_SENSOR
+                || req == SCREEN_ORIENTATION_FULL_SENSOR
+                || req == SCREEN_ORIENTATION_FULL_USER
+                || req == SCREEN_ORIENTATION_USER
+                || req == SCREEN_ORIENTATION_NOSENSOR) {
+            bstOrientationValue = SCREEN_ORIENTATION_UNSPECIFIED;
+        }
+        return bstOrientationValue;
+    }
