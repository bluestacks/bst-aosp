                 pkg.getBaseApkPath(), pkg.isSystem(),
-                isUpdatedSystemApp);
+                isUpdatedSystemApp, pkg.isMultiArch());
 
         final boolean extractLibs = shouldExtractLibs(pkg, isUpdatedSystemApp);
 
@@ -496,7 +507,7 @@ final class PackageAbiHelperImpl implements PackageAbiHelper {
         return new Pair<>(abis,
                 deriveNativeLibraryPaths(abis, appLib32InstallDir,
                         pkg.getPath(), pkg.getBaseApkPath(), pkg.isSystem(),
-                        isUpdatedSystemApp));
+                        isUpdatedSystemApp, pkg.isMultiArch()));
     }
 
     private boolean shouldExtractLibs(AndroidPackage pkg, boolean isUpdatedSystemApp) {
@@ -504,7 +515,15 @@ final class PackageAbiHelperImpl implements PackageAbiHelper {
         boolean extractLibs = !AndroidPackageUtils.isLibrary(pkg) && pkg.isExtractNativeLibs();
         // We shouldn't attempt to extract libs from system app when it was not updated.
         if (pkg.isSystem() && !isUpdatedSystemApp) {
-            extractLibs = false;
+            // ROB-14090: We want to extract libraries of uncube launcher3 explicitly as
+            // it has used compressed format which causes library missing issue at runtime.
+            if (PackageManagerService.bstIsFirstBootOrUpgrade()
+                    && (pkg.getPackageName().equals("com.uncube.launcher3")
+                    || pkg.getPackageName().equals("com.uncube.gamevantage"))) {
+                extractLibs = true;
+            } else {
+                extractLibs = false;
+            }
         }
         return extractLibs;
     }
