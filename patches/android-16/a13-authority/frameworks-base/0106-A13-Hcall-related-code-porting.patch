+    private void sendNotificationToHost(String pkgName, Notification notification, NotificationRecord nr) {
+        PackageManager pm = getContext().getPackageManager();
+        ApplicationInfo ai;
+
+        if(notification.isGroupSummary()) {
+            if(DBG)
+            Slog.d(TAG, "Not sending group summary notification");
+            return;
+        }
+
+        int progress = notification.extras.getInt(notification.EXTRA_PROGRESS);
+        int progressMax = notification.extras.getInt(notification.EXTRA_PROGRESS_MAX);
+
+        if (progress != 0 || progressMax != 0) {
+            return;
+        }
+
+        //ROB-4252: If the notification is an update to an older notification and is of low priority, do not send it to host.
+        if (nr.isUpdate && (nr.getImportance() <= IMPORTANCE_LOW)) {
+            if (DBG) Slog.d(TAG, "Low importance update notification, not sending to host");
+            return;
+        }
+
+        try {
+            ai = pm.getApplicationInfo(pkgName, PackageManager.GET_META_DATA);
+            int mask = ApplicationInfo.FLAG_SYSTEM | ApplicationInfo.FLAG_UPDATED_SYSTEM_APP;
+            boolean isSystemApp = ((ai.flags & mask) != 0);
+            if(isSystemApp) {
+                if(DBG)
+                    Slog.d(TAG, "Not sending notification for system app: " + pkgName);
+                return;
+            }
+        } catch(Exception e) {
+            Log.e(TAG, "Error in sendNotificationToHost: " + e.getMessage());
+            e.printStackTrace();
+            return;
+        }
+        String packageName = pkgName ;
+        String appName = (String) pm.getApplicationLabel(ai);
+        String contentTitle = notification.extras.getCharSequence(notification.EXTRA_TITLE,"").toString();
+        String contentText = notification.extras.getCharSequence(notification.EXTRA_TEXT, "").toString();
+        long mSecs = notification.when;
+        String notificationData = "";
+
+        try {
+            JSONObject json = new JSONObject();
+            json.put("packageName", packageName);
+            json.put("appName", appName);
+            json.put("contentTitle", contentTitle);
+            json.put("contentText", contentText);
+            json.put("mSecsFromEpochUTC", mSecs);
+            notificationData = json.toString();
+        } catch(Exception e) {
+            Log.e (TAG, "Error in sendNotificationInfo: " + e.getMessage());
+            e.printStackTrace();
+            notificationData = "Exception while processing notificationData";
+            return;
+        }
+
+        if (DBG) {
+            Slog.d(TAG, "Sending Notification data to host : " + notificationData);
+        }
+        mBstHostCallManagerService = (BstHostCallManager) getContext().getSystemService(Context.BST_HOST_CALL);
+        int rval = mBstHostCallManagerService.onAppNotificationReceived(notificationData);
+        if(rval != 0)
