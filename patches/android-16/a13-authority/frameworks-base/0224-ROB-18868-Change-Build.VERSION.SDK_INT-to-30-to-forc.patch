+static void BstSetVersionCode(JNIEnv* env, const char* clsname, const char* name, const int value) {
+    ScopedLocalRef<jclass> cls(env, env->FindClass(clsname));
+    if (cls.get() == nullptr) {
+        env->ExceptionClear();
+        ALOGW("Could not find %s cls.", clsname);
+        return;
+    }
+
+    jfieldID field_id = env->GetStaticFieldID(cls.get(), name, "I");
+    if (field_id == nullptr) {
+        env->ExceptionClear();
+        ALOGW("Could not find %s field.", name);
+        return;
+    }
+    env->SetStaticIntField(cls.get(), field_id, value);
+}
