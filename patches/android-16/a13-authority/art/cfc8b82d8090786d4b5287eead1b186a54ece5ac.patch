From: "henry@bluestacks.com" <henry@bluestacks.com>
Date: Tue, 9 Jan 2024 16:27:02 +0800
Subject: [PATCH] [A13] [ROB-9384] Fix Promon emulator detection by using
 config db pmf set as true (#12)

---
 libnativebridge/native_bridge.cc | 122 +++++++++++++++++++++++++++++++
 1 file changed, 122 insertions(+)

diff --git a/libnativebridge/native_bridge.cc b/libnativebridge/native_bridge.cc
index c32919ce60..067d0e5332 100755
--- a/libnativebridge/native_bridge.cc
+++ b/libnativebridge/native_bridge.cc
@@ -375,6 +375,22 @@ static void MountCpuinfoForInstructionSet(const char* instruction_set) {
 #endif
 }
 
+static char g_pkgname[256];
+
+static inline void init_pkgname(const char* app_data_dir_in)
+{
+  g_pkgname[0] = 0;
+  if (app_data_dir_in == nullptr) return;
+
+  const char* str = strrchr(app_data_dir_in, '/');
+  if (str == nullptr) return;
+
+  size_t len = strlen(++str);
+  if (len >= sizeof(g_pkgname)) len = sizeof(g_pkgname) - 1;
+  memcpy(g_pkgname, str, len);
+  g_pkgname[len] = 0;
+}
+
 bool PreInitializeNativeBridge(const char* app_data_dir_in, const char* instruction_set) {
   if (state != NativeBridgeState::kOpened) {
     ALOGE("Invalid state: native bridge is expected to be opened.");
@@ -383,6 +399,7 @@ bool PreInitializeNativeBridge(const char* app_data_dir_in, const char* instruct
   }
 
   if (app_data_dir_in != nullptr) {
+    init_pkgname(app_data_dir_in);
     // Create the path to the application code cache directory.
     // The memory will be release after Initialization or when the native bridge is closed.
     const size_t len = strlen(app_data_dir_in) + strlen(kCodeCacheDir) + 2;  // '\0' + '/'
@@ -832,9 +849,114 @@ native_bridge_namespace_t* NativeBridgeGetExportedNamespace(const char* name) {
   return nullptr;
 }
 
+#if defined(__LP64__) && defined(__ANDROID__)
+class ArmHandle {
+  void* m_handle = nullptr;
+public:
+  ArmHandle(void* handle) : m_handle(handle)  {}
+  ~ArmHandle() { if (m_handle) NativeBridgeUnloadLibrary(m_handle); }
+};
+
+#define BST_MAX_SMALL_FILE_SIZE (1024 * 1024)
+/** Allocate a buffer to read a small regular file. */
+char* _bst_read_small_file(const char* file_path, loff_t* file_size)
+{
+    FILE *fp;
+    struct stat st;
+    char *buf = NULL;
+    loff_t f_size = 0;
+    ssize_t bytes = 0;
+
+    fp = fopen(file_path, "r");
+    if (!fp) {
+        // ALOGE("Error in fopen file %s\n", file_path);
+        goto out;
+    }
+
+    if (fstat(fileno(fp), &st) && !S_ISREG(st.st_mode)) {
+        ALOGE("Error in fstat file %s\n", file_path);
+        goto out;
+    }
+
+    /* file is opened successfully, read it in a buffer */
+    f_size = st.st_size;
+    if (f_size <= 0) {
+        ALOGE("Error in getting size of file %s\n", file_path);
+        goto out;
+    }
+
+    if (f_size > BST_MAX_SMALL_FILE_SIZE) {
+        ALOGE("The size of the file %s is too large\n", file_path);
+        goto out;
+    }
+
+    /* The file content is expected as a string, so allocate one more byte.*/
+    buf = (char *)malloc(f_size + 1);
+    if (!buf) {
+        ALOGE("Error in allocating buffer for file %s\n", file_path);
+        goto out;
+    }
+
+    memset(buf, 0, sizeof(buf));
+    bytes = fread(buf, f_size, 1, fp);
+    if (bytes < 0) {
+        ALOGE("Error in reading file %s\n", file_path);
+        free(buf);
+        buf = NULL;
+        goto out;
+    }
+
+    *file_size = f_size;
+    // ALOGE("File %s read successfully\n", file_path);
+
+out:
+    if (fp != NULL)
+        fclose(fp);
+
+    return buf;
+}
+
+bool bst_is_pmf_app(const char *calling_pkg)
+{
+#define PMF_FILE_PATH "/data/downloads/.tmp/.pmf"
+    char *file_buf, *temp, *token;
+    loff_t file_size  = 0;
+    bool ret = false;
+
+    file_buf = _bst_read_small_file(PMF_FILE_PATH, &file_size);
+    if (!file_buf || !calling_pkg)
+        goto out;
+
+    // Read app name line by line
+    temp = file_buf;
+    while ((token = strsep(&temp, ";")) != NULL && strlen(token) > 0) {
+        if (strcmp(token, calling_pkg) == 0) {
+            ret = true;
+            break;
+        }
+    }
+
+out:
+    if (file_buf)
+        free(file_buf);
+
+    return ret;
+}
+
+static inline void* load_arm_lib(native_bridge_namespace_t* ns)
+{
+  if (!bst_is_pmf_app(g_pkgname)) return nullptr;
+  const char* lib = "/data/downloads/libpmf.so";
+  return callbacks->loadLibraryExt(lib, RTLD_NOW, ns);
+}
+#endif
+
 void* NativeBridgeLoadLibraryExt(const char* libpath, int flag, native_bridge_namespace_t* ns) {
   if (NativeBridgeInitialized()) {
     if (isCompatibleWith(NAMESPACE_VERSION)) {
+#if defined(__LP64__) && defined(__ANDROID__)
+      static ArmHandle ah(load_arm_lib(ns));
+#endif
       return callbacks->loadLibraryExt(libpath, flag, ns);
     } else {
       ALOGE("not compatible with version %d, cannot load library in namespace", NAMESPACE_VERSION);
-- 
