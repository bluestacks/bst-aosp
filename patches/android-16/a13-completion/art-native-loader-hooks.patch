+      if (install_hooks != nullptr) {
+        install_hooks();
+      }
+    }
+  }
+
+  ~HotFixHookLibrary() {
+    if (handle_ != nullptr) {
+      dlclose(handle_);
+    }
+  }
+
+  HotFixHookLibrary(const HotFixHookLibrary&) = delete;
+  HotFixHookLibrary& operator=(const HotFixHookLibrary&) = delete;
+
+ private:
+  void* handle_ = nullptr;
+};
