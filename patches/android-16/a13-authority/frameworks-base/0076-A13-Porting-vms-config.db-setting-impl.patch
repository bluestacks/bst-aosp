From: "henry@bluestacks.com" <henry@bluestacks.com>
Date: Fri, 17 Nov 2023 16:39:28 +0800
Subject: [PATCH 076/224] [A13] Porting vms config.db setting impl

---
 core/jni/com_android_internal_os_Zygote.cpp   | 51 +++++++++++++++++++
 .../server/am/ActivityManagerService.java     | 41 +++++++++++++++
 2 files changed, 92 insertions(+)

diff --git a/core/jni/com_android_internal_os_Zygote.cpp b/core/jni/com_android_internal_os_Zygote.cpp
index 3b13804a3b17..4976ce5b74de 100644
--- a/core/jni/com_android_internal_os_Zygote.cpp
+++ b/core/jni/com_android_internal_os_Zygote.cpp
@@ -1888,6 +1888,41 @@ out:
 
     return ret;
 }
+
+bool bst_get_memorysize_app(const char *calling_pkg, char *pbuf, int bufsize)
+{
+#define MEMORYSIZE_FILE_PATH "/data/downloads/.tmp/.bstMemorySizeApps"
+    char *file_buf, *temp, *token, *subtoken_pkg, *subtoken_value;
+    loff_t file_size, len;
+    bool ret = false;
+
+    file_buf = _bst_read_small_file(MEMORYSIZE_FILE_PATH, &file_size);
+    if (!file_buf || !calling_pkg)
+        goto out;
+
+    // Read app name line by line
+    temp = file_buf;
+    while ((token = strsep(&temp, "\n")) != NULL && strlen(token) > 0) {
+        subtoken_pkg = token;
+        if ((token = strchr(token, ';')) != NULL && strlen(token) > 0) {
+            subtoken_value = token + 1;
+            *token = '\0';
+            if (strcmp(subtoken_pkg, calling_pkg) == 0) {
+                len = bufsize > strlen(subtoken_value) ? bufsize - 1 : strlen(subtoken_value);
+                memcpy(pbuf, subtoken_value, len);
+                ret = true;
+                break;
+            }
+        }
+    }
+
+out:
+    if (file_buf)
+        free(file_buf);
+
+    return ret;
+}
+
 // Utility routine to specialize a zygote child process.
 static void SpecializeCommon(JNIEnv* env, uid_t uid, gid_t gid, jintArray gids, jint runtime_flags,
                              jobjectArray rlimits, jlong permitted_capabilities,
@@ -2007,6 +2042,22 @@ static void SpecializeCommon(JNIEnv* env, uid_t uid, gid_t gid, jintArray gids,
         }
     }
 
+    if (uid >= 10000) {
+        char memorySize[128] = { '\0', };
+        if (bst_get_memorysize_app(g_pkgname, memorySize, sizeof(memorySize)) && strlen(memorySize) > 0) {
+            char meminfo_path[1024] = { '\0', };
+            sprintf(meminfo_path, "%s%s", "/data/downloads/.tmp/xmeminfo.", memorySize);
+            // Bind-mount
+            if (TEMP_FAILURE_RETRY(mount(meminfo_path,        // Source.
+                                   "/proc/meminfo",     // Target.
+                                   nullptr,             // FS type.
+                                   MS_BIND,             // Mount flags: bind mount.
+                                   nullptr)) == -1) {   // "Data."
+                ALOGW("Failed to bind-mount %s as /proc/meminfo: %s", meminfo_path, strerror(errno));
+            }
+        }
+    }
+
     if (setresgid(gid, gid, gid) == -1) {
         fail_fn(CREATE_ERROR("setresgid(%d) failed: %s", gid, strerror(errno)));
     }
