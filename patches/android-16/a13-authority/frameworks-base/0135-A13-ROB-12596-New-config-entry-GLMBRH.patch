@@ -3139,6 +3156,11 @@ public class BstFilterAppsService extends IBstFilterAppsService.Stub {
             mFixedSurfaceRotationAppList.clear();
         }
 
+        synchronized (mGlMapBufferRangeHostAppList)
+        {
+            mGlMapBufferRangeHostAppList.clear();
+        }
+
         if(DEBUG) Slog.d(TAG,"loading config Db");
 
         // Giving 1st preference to /data/downloads/.config_user.db file, is this file is not present then we check for .config.db in /data/downloads/
@@ -7097,4 +7119,32 @@ public class BstFilterAppsService extends IBstFilterAppsService.Stub {
         if (DEBUG) Slog.d(TAG, pkgName + " get iap setting failure\n");
         return null;
     }
+
+    /**
+     * @hide
+     */
+    public boolean isGlMapBufferRangeHost(String pkgName)
+    {
+        if (DEBUG) Slog.d(TAG, "Trying to look for " + pkgName + " in GlMapBufferRangeHost app list\n");
+        initLists();
+
+        synchronized (mGlMapBufferRangeHostAppList)
+        {
+            if (mGlMapBufferRangeHostAppList.contains(pkgName))
+            {
+                return true;
+            }
+            else
+            {
+                String wildcardMatchedPackageName = isPackageMatchedWilcard(mGlMapBufferRangeHostAppList, pkgName);
+                if(wildcardMatchedPackageName != null)
+                {
+                    if (DEBUG) Slog.d(TAG, pkgName + " is in GlMapBufferRangeHost App List\n");
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
 }
