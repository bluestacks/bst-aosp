From 7f96b596a749046fefd1fe87c683ecc2cdb48bc7 Mon Sep 17 00:00:00 2001
From: mark-bst <zeqing.xu@bluestacks.com>
Date: Tue, 4 Aug 2026 16:32:24 +0800
Subject: [PATCH] [A16] Tolerate delayed Bluetooth keystore startup

---
 .../btservice/bluetoothKeystore/BluetoothKeystoreService.java | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/android/app/src/com/android/bluetooth/btservice/bluetoothKeystore/BluetoothKeystoreService.java b/android/app/src/com/android/bluetooth/btservice/bluetoothKeystore/BluetoothKeystoreService.java
index 050aa14db6..2d98aaf20c 100644
--- a/android/app/src/com/android/bluetooth/btservice/bluetoothKeystore/BluetoothKeystoreService.java
+++ b/android/app/src/com/android/bluetooth/btservice/bluetoothKeystore/BluetoothKeystoreService.java
@@ -153,6 +153,10 @@ public class BluetoothKeystoreService {
         } catch (KeyStoreException e) {
             reportKeystoreException(e, "cannot find the keystore");
             return;
+        } catch (RuntimeException e) {
+            // Keystore2 may not be published yet when the Bluetooth service starts.
+            errorLog("keystore service is not ready: " + e);
+            return;
         }
 
         loadConfigData();
-- 
2.34.1

