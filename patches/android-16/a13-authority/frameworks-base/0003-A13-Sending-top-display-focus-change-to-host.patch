+    void bstSendTopDisplayedOnFocusChange(WindowState newFocus) {
+        String lastTopDisplayedPackage = SystemProperties.get("bst.config.top_displayed_pkg" , "");
+        String packageName = newFocus.getOwningPackage();
+        ActivityRecord activityRecord = newFocus.mActivityRecord;
+        if (activityRecord == null) {
+            if (DEBUG_VISIBILITY) Slog.d(TAG, "activityRecord is null so returning");
+            return;
+        }
+
+        String activityRecordStr = activityRecord.toString();
+        Slog.e(TAG, "bstSendTopDisplayedOnFocusChange activityRecordStr: " + activityRecordStr);
+        String[] splitsAppToken = activityRecordStr.split(" ");
+        for (int i=0; i<splitsAppToken.length; i++) {
+            Slog.e(TAG, i + ": " + splitsAppToken[i]);
+        }
+        if (splitsAppToken.length < 4) {
+            Slog.e(TAG, "activityRecord is invalid, activityRecordStr: " + activityRecordStr + ", so returning");
+            return;
+        }
+
+        String componentName = splitsAppToken[2].trim();
+        if (componentName.endsWith("}")) {
+            componentName = componentName.substring(0, componentName.length() - 1);
+            Slog.e(TAG, "bstSendTopDisplayedOnFocusChange Modified componentName: " + componentName);
+        }
+        Slog.e(TAG, "bstSendTopDisplayedOnFocusChange componentName: " + componentName);
+
+        if(packageName == null) {
+            if (DEBUG_VISIBILITY)  Slog.d(TAG, "packageName is null through getOwningPackage, falling back to parsing activityRecord to get packagename");
+            // See toString() of ActivityRecord for token format.
+            // We are assuming <package-name>/<activity-name> in the token string.
+            packageName = componentName.substring(0, componentName.indexOf("/")).trim();
+            Slog.e(TAG, "bstSendTopDisplayedOnFocusChange packageName: " + packageName);
+        }
+
+        String activityName = componentName.substring(componentName.indexOf("/") + 1, componentName.length()).trim();
+            Slog.e(TAG, "bstSendTopDisplayedOnFocusChange activityName: " + activityName);
+        if (activityName.startsWith(".")) {
+            activityName = packageName + activityName;
+        }
+        if (packageName.length() > SystemProperties.PROP_VALUE_MAX)
+            packageName = packageName.substring(0,SystemProperties.PROP_VALUE_MAX);
+
+        if (DEBUG_VISIBILITY) Slog.d(TAG, "Now Visible : " + activityRecord.toString()
+                                     + " current top displayed package name : " +  ((packageName != null) ? packageName : "null")
+                                     + " lastTopDisplayedPackage " + lastTopDisplayedPackage);
+
+        try {
+            //Set lastDisplayedPackage when appToken is corresponding to PhoenixAcquireActivity.
+            //This will store the packageName in which IAP is being done.
+            String giapActivityName = "com.google.android.finsky.billing.acquire.SheetUiBuilderHostActivity";
+            String giapActivityName2 = android.os.SystemProperties.get("bst.config.giap_activity", giapActivityName);
+            if ((activityName != null
+                        && (activityName.contains(giapActivityName)
+                            || activityName.contains(giapActivityName2)))
+                    && (packageName != null)
+                    && (packageName.equals("com.android.vending"))
+                    && !(lastTopDisplayedPackage.startsWith("com.android")
+                        || lastTopDisplayedPackage.startsWith("com.google.android"))) {
+                if (DEBUG_VISIBILITY) Slog.d(TAG, "lastDisplayedPackage updated to " + lastTopDisplayedPackage + ", previous value = " + SystemProperties.get("bst.config.last_displayed_pkg", null));
+                    SystemProperties.set("bst.config.last_displayed_pkg", lastTopDisplayedPackage);
+                }
+        } catch (Exception ex) {
+            Slog.w(TAG, "Exception in AppWindowToken for " + activityRecord + " : " + ex.getMessage());
+            if (DEBUG_VISIBILITY) ex.printStackTrace();
+        }
+
+        if (packageName != null && !packageName.equalsIgnoreCase(lastTopDisplayedPackage)
+                                && activityName != null && !activityName.equalsIgnoreCase("com.android.settings.FallbackHome")) {
+            //Set bst.config.top_displayed_pkg property to the current owning package,
+            //and send this info to host.
+            Slog.d(TAG, "calling BstHostCallManagerService onActivityDisplayed method, packageName: " + packageName + ", activityName: " + activityName);
+            SystemProperties.set("bst.config.top_displayed_pkg", packageName);
+            SystemProperties.set("bst.config.show_mouse_ptr", "false");
+            String callingPackage = SystemProperties.get("bst.config.calling_package", "");
+            int rval = mBstHostCallManagerService.onActivityDisplayed(packageName, activityName, callingPackage);
+            Slog.d(TAG, "BstHostCallManagerService onActivityDisplayed method returned: " + rval);
+            if (rval != 0) {
+                Slog.w(TAG, "ERROR in sending topDisplayedPackage request, rval = " + rval);
+            }
+
+            boolean showSignInPopup = (SystemProperties.getInt("bst.enable_sigin_gamelaunch", 1) == 0 ? false : true);
+            if (showSignInPopup && mBstFilterApps.isGoogleSignInRequired(packageName)) {
+                Account[] accounts = AccountManager.get(mContext).getAccountsByType("com.google");
+                if (accounts.length == 0) {
+                    Intent intent = new Intent();
+                    intent.setPackage("com.bluestacks.home");
+                    intent.setAction("com.bluestacks.home.DISPLAY_SIGNIN_POPUP");
+                    intent.putExtra("app_pkg", packageName);
+                    mContext.startServiceAsUser(intent, Process.myUserHandle());
+                    SystemProperties.set("bst.display_signin_popup", "true");
+                }
+            }
+            //Sending macrosDisabled modifier value to host for top displayed package
+            boolean macrosDisabled = mBstFilterApps.isMacrosDisabledApp(packageName);
+            boolean showFeedbackPopup = mBstFilterApps.showFeedbackPopup(packageName);
+            String mouseCursorStyle = mBstFilterApps.getMouseCursorStyle(packageName);
+            boolean nativeGamepad = mBstFilterApps.isEnableNativeGamePad(packageName);
+            Slog.d(TAG, "calling BstHostCallManagerService setAppConfigDbParams method, packageName: " + packageName
+                        + ", macrosDisabled: " + macrosDisabled
+                        + ", showFeedbackPopup: " + showFeedbackPopup
+                        + ", mouseCursorStyle: " + mouseCursorStyle
+                        + ", nativeGamepad: " + nativeGamepad);
+            rval = mBstHostCallManagerService.setAppConfigDbParams(packageName, macrosDisabled, showFeedbackPopup, mouseCursorStyle, nativeGamepad);
+            Slog.d(TAG, "BstHostCallManagerService setAppConfigDbParams method returned: " + rval);
+            if (rval != 0) {
+                Slog.w(TAG, "ERROR in sending setAppConfigDbParams request, rval = " + rval);
+            }
+        }
+        String mouseAction = mBstFilterApps.getMouseAction(packageName, activityName);
+        String lastSentMouseAction = SystemProperties.get("bst.config.last_mouse_action", "");
+        Slog.d(TAG, "bstSendTopDisplayedOnFocusChange packageName : "+ packageName
+                        + "  activityName : "+ activityName
+                        + "  mouseAction  : "+ mouseAction
+                        + "  lastSentMouseAction : "+ lastSentMouseAction);
+
+        if( !mouseAction.isEmpty() || !lastSentMouseAction.isEmpty()) {
+             int rval = mBstHostCallManagerService.onSetMouseAction(packageName, activityName, mouseAction);
+             SystemProperties.set("bst.config.last_mouse_action", mouseAction);
+             if (rval != 0) {
+                Slog.w(TAG, "ERROR in sending onSetMouseAction request, rval = " + rval);
+             }
+        }
+    }
+
