PROP_FILE="/data/.def.prop"
VENDOR_PROP_FILE="/data/.vendor.prop"

setup_dpi()
{
	if [ -n "$BST_DPI" ]; then
        OLD_DPI=`grep "ro\.sf\.lcd_density" $PROP_FILE | cut -d '=' -f 2`
        if [ $OLD_DPI -ne $BST_DPI ]; then
	        sed -i "s/ro.sf.lcd_density=[0-9]*/ro.sf.lcd_density=$BST_DPI/" default.prop
            if [ -f $PROP_FILE ]; then
	            sed -i "s/ro.sf.lcd_density=[0-9]*/ro.sf.lcd_density=$BST_DPI/" $PROP_FILE
            fi
        fi
        VENDOR_OLD_DPI=`grep "ro\.sf\.lcd_density" $VENDOR_PROP_FILE | cut -d '=' -f 2`
        if [ $VENDOR_OLD_DPI -ne $BST_DPI ]; then
            if [ -f $VENDOR_PROP_FILE ]; then
	            sed -i "s/ro.sf.lcd_density=[0-9]*/ro.sf.lcd_density=$BST_DPI/" $VENDOR_PROP_FILE
            fi
        fi
        if [ -f $PROP_FILE ]; then
            # The default.prop file and .def.prop file should only differ on ro.bootimage.build.fingerprint
            # if not, to avoid boot failures due to file corruption, resetting it to default.prop
            DIFF=`/system/xbin/busybox diff -w default.prop $PROP_FILE | tail -n +3 | grep -E "^(\+|-).*$" | grep -v "ro.bootimage.build.fingerprint" | grep -v "ro.sf.lcd_density"`
            if [ "$DIFF" ]; then
                fingerprint=`grep -i "ro\.build\.fingerprint" /data/.bluestacks.prop | cut -d "=" -f 2`
                sed "/ro.bootimage.build.fingerprint=*/c ro.bootimage.build.fingerprint=${fingerprint}" /default.prop > $PROP_FILE
                sed -i "s/ro.sf.lcd_density=[0-9]*/ro.sf.lcd_density=$BST_DPI/" default.prop
                if [ -f $PROP_FILE ]; then
                    sed -i "s/ro.sf.lcd_density=[0-9]*/ro.sf.lcd_density=$BST_DPI/" $PROP_FILE
                fi
            fi
        fi
    fi
}
