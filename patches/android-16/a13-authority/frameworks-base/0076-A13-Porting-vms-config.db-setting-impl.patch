@@ -318,6 +318,7 @@ import android.text.TextUtils;
 import android.text.style.SuggestionSpan;
 import android.util.ArrayMap;
 import android.util.ArraySet;
+import android.util.BstUtils;
 import android.util.EventLog;
 import android.util.FeatureFlagUtils;
 import android.util.IntArray;
@@ -458,6 +459,8 @@ import java.util.concurrent.CopyOnWriteArrayList;
 import java.util.concurrent.Executor;
 import java.util.concurrent.atomic.AtomicInteger;
 
+import com.bluestacks.os.BstFilterAppsManager;
+
 public class ActivityManagerService extends IActivityManager.Stub
         implements Watchdog.Monitor, BatteryStatsImpl.BatteryCallback, ActivityManagerGlobalLock {
 
@@ -590,6 +593,8 @@ public class ActivityManagerService extends IActivityManager.Stub
 
     private Installer mInstaller;
 
+    BstFilterAppsManager mBstFilterApps;
+
     final InstrumentationReporter mInstrumentationReporter = new InstrumentationReporter();
 
     @CompositeRWLock({"this", "mProcLock"})
@@ -6277,7 +6282,43 @@ public class ActivityManagerService extends IActivityManager.Stub
 
     @Override
     public void getMemoryInfo(ActivityManager.MemoryInfo outInfo) {
+        boolean DEBUG = SystemProperties.getInt("bst.debug.fakemem", 0) > 0;
+
         mProcessList.getMemoryInfo(outInfo);
+
+        // if total mem is less than provided value from config.db (for example 2100mb - 2100*1024*1024), increase total mem for packages
+        // which have vms in config.db.
+        // This is needed for apps like com.netmarble.lin2ws as they requires more than 1.5GB.
+        // For systems having less than 1.5GB RAM, they show "device incompatible" error.
+        if (mBstFilterApps == null)
+            mBstFilterApps = (BstFilterAppsManager) mContext.getSystemService(Context.BST_FILTER_APPS);
+
+        if (DEBUG) {
+            int pid = Binder.getCallingPid();
+            String pkgName = BstUtils.getAppNameFromPid(pid);
+            Log.d(TAG, "getMemoryInfo() called with: pid: " + pid + " pkgName is : " + pkgName );
+        }
+
+        int uid = Binder.getCallingUid();
+        String memorySize = mBstFilterApps.getMemorySize(uid);
+        if (!memorySize.isEmpty()) {
+            if (DEBUG) Log.d(TAG, "getMemoryInfo() actual : total mem is  " + outInfo.totalMem + " avail mem is :" + outInfo.availMem);
+            long fakeTotalMem = 0L;
+            try {
+                fakeTotalMem = Long.parseLong(memorySize);
+            } catch (Exception e) {
+                e.printStackTrace();
+                Log.d(TAG, "getMemoryInfo() exception in parsing memorySize setting : " + fakeTotalMem);
+            }
+
+            if (outInfo.totalMem < fakeTotalMem) {
+                outInfo.totalMem = fakeTotalMem;
+                if (DEBUG) Log.d(TAG, "getMemoryInfo() returning total mem: " + outInfo.totalMem);
+            } else {
+                if (DEBUG) Log.d(TAG, "returning orig values from getMemoryInfo(), total mem: " + outInfo.totalMem);
+            }
+        }
+        if (DEBUG) Log.d(TAG, "getMemoryInfo() returned: total mem is: " + outInfo.totalMem + " avail mem is :" + outInfo.availMem);
     }
 
     // =========================================================
