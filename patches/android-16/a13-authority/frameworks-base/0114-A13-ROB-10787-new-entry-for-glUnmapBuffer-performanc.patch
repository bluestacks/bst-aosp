     private boolean mListsInited = false;
     private String  mBrowserUrl  = "";
@@ -2359,6 +2360,22 @@ public class BstFilterAppsService extends IBstFilterAppsService.Stub {
                                         removePackageEntryFromList(mGLProgramBinaryAppList,pkgException);
                                     }
                                 }
+                                else if (key.equalsIgnoreCase("GLUBPerf")) {
+                                    synchronized (mGLUnmapBufferPerfAppList) {
+                                        if (value.equalsIgnoreCase("false")) {
+                                            packageName = "~" + packageName;
+                                        }
+                                        if (DEBUG)
+                                            Slog.d(TAG, "Adding " + packageName + " to mGLUnmapBufferPerfAppList \n");
+                                        mGLUnmapBufferPerfAppList.add(packageName);
+                                        if (packageName.startsWith("~")) {
+                                            if (DEBUG)
+                                                Slog.d(TAG, "Removing " + origPackageName + " from mGLUnmapBufferPerfAppList \n");
+                                            mGLUnmapBufferPerfAppList.remove(packageName.substring(1));
+                                        }
+                                        removePackageEntryFromList(mGLUnmapBufferPerfAppList,pkgException);
+                                    }
+                                }
                             }
                             // one rule parsing finished, no need to parse other rule..
                             // as more specific rules are above generic rule, if we have applied a more specific rule, do not apply generic rule
@@ -2990,6 +3007,11 @@ public class BstFilterAppsService extends IBstFilterAppsService.Stub {
             mGLProgramBinaryAppList.clear();
         }
 
+        synchronized (mGLUnmapBufferPerfAppList)
+        {
+            mGLUnmapBufferPerfAppList.clear();
+        }
+
         if(DEBUG) Slog.d(TAG,"loading config Db");
 
         // Giving 1st preference to /data/downloads/.config_user.db file, is this file is not present then we check for .config.db in /data/downloads/
@@ -6540,6 +6562,35 @@ public class BstFilterAppsService extends IBstFilterAppsService.Stub {
         return false;
     }
 
+    /**
+     * Check if this app need perf in glUnmapBuffer
+     * case ROB-10787: Adding a new entry name: GLUBPerf
+     * @hide
+     */
+    public boolean isGLUnmapBufferPerfApp(String pkgName)
+    {
+        if (DEBUG) Slog.d(TAG, "Trying to look for " + pkgName + " in GLUnmapBufferPerf app list\n");
+        initLists();
+
+        synchronized (mGLUnmapBufferPerfAppList)
+        {
+            if (mGLUnmapBufferPerfAppList.contains(pkgName))
+            {
+                return true;
+            }
+            else
+            {
+                String wildcardMatchedPackageName = isPackageMatchedWilcard(mGLUnmapBufferPerfAppList, pkgName);
+                if(wildcardMatchedPackageName != null)
+                {
+                    if (DEBUG) Slog.d(TAG, pkgName + " is in GLUnmapBufferPerf App List\n");
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
     private static class ActivityManagerServiceHolder {
         static final ActivityManagerInternal mActivityManagerService = LocalServices.getService(ActivityManagerInternal.class);
     };
