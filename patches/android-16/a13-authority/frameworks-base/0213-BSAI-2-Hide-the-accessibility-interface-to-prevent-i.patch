+                
+                StringBuilder packageList = new StringBuilder();
+                for (String pkg : packages) {
+                    if (packageList.length() > 0) packageList.append(", ");
+                    packageList.append(pkg);
+                }
+                
+                // Check if any package is system app
+                for (String packageName : packages) {
+                    android.content.pm.ApplicationInfo appInfo = mProvider.getContext()
+                        .getPackageManager().getApplicationInfo(packageName, 0);
+                    if (appInfo != null && ((appInfo.flags & android.content.pm.ApplicationInfo.FLAG_SYSTEM) != 0 || 
+                        (appInfo.flags & android.content.pm.ApplicationInfo.FLAG_UPDATED_SYSTEM_APP) != 0)) {
+                        return false; // System app found
+                    }
+                }
+                return true; // No system apps found, it's third-party
+            } catch (Exception e) {
