+++ b/services/core/java/com/android/server/wm/WindowManagerService.java
@@ -6272,6 +6272,11 @@ public class WindowManagerService extends IWindowManager.Stub
         }
         String mouseAction = mBstFilterApps.getMouseAction(packageName, activityName);
         String lastSentMouseAction = SystemProperties.get("bst.config.last_mouse_action", "");
+        ///ROB-11421, roblox now only support singleSurface which won't tigger focusChange, so we use SYSTEM_UI_FLAG_FULLSCREEN instead.
+        if (packageName != null && packageName.equals("com.roblox.client")) {
+            int subtreeSystemUiVis = newFocus.getAttrs().subtreeSystemUiVisibility;
+            mouseAction = (subtreeSystemUiVis & View.SYSTEM_UI_FLAG_FULLSCREEN) == View.SYSTEM_UI_FLAG_FULLSCREEN ? "enableNative" : "";
+        }
         Slog.d(TAG, "bstSendTopDisplayedOnFocusChange packageName : "+ packageName
                         + "  activityName : "+ activityName
                         + "  mouseAction  : "+ mouseAction
