index 59ad0beec903..9621cdf8c7d8
--- a/services/java/com/bluestacks/server/native/com_bluestacks_server_BstHostCallService.cpp
+++ b/services/java/com/bluestacks/server/native/com_bluestacks_server_BstHostCallService.cpp
@@ -940,6 +940,22 @@ static jint allowInstallApkGameCenter(JNIEnv* env, jobject clazz, jstring pkg) {
     return 0;
 }
 
+static jint onNowggSigninClicked(JNIEnv* env, jobject clazz, jstring pkg) {
+    if (dbg) ALOGD("%s: called", __func__);
+
+    string pkgString = getStringFromJstring(env, clazz, pkg);
+
+    xthrPoolAddTask(&g_thr_pool.threadPool, [=]
+        {
+            xerr_t rval = hcallOnNowggSigninClickedRpc(pkgString.c_str());
+            if (rval != XERR_SUCCESS) {
+                ALOGE("RPC failed for %s, error %d", __func__, rval);
+            }
+            if (dbg) ALOGD("%s: returning, rval = %d", __func__, rval);
+        });
+    return 0;
+}
+
 /*
  * JNI registration.
  */
@@ -998,7 +1014,8 @@ static const JNINativeMethod gMethods[] = {
     { "native_commonCommand", "(ILjava/lang/String;Ljava/lang/String;)I", (void*)commonCommand },
     { "native_onIAPCompleted", "(Ljava/lang/String;Ljava/lang/String;)I", (void*)onIAPCompleted },
     { "native_unzipFile", "(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)I", (void*)unzipFile },
-    { "native_allowInstallApkGameCenter", "(Ljava/lang/String;)I", (void*)allowInstallApkGameCenter }
+    { "native_allowInstallApkGameCenter", "(Ljava/lang/String;)I", (void*)allowInstallApkGameCenter },
+    { "native_onNowggSigninClicked", "(Ljava/lang/String;)I", (void*)onNowggSigninClicked }
 };
 
