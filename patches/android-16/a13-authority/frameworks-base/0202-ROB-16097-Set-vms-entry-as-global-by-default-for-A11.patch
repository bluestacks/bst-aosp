+static std::string convertWildcardToRegex(const std::string& wildcard) {
+    std::string regexPattern;
+    regexPattern.reserve(wildcard.size() * 2); // Reserve space
+
+    // Special character escape table
+    static const std::string regexSpecialChars = ".^$|()[]{}*+?\\";
+    for(char c : wildcard) {
+        switch(c) {
+            case '*':
+                regexPattern += ".*";
+                break;
+            case '?':
+                regexPattern += ".";
+                break;
+            default:
+                if(regexSpecialChars.find(c) != std::string::npos) {
+                    regexPattern += '\\';
+                }
+                regexPattern += c;
+        }
+    }
+
+    // Ensure the full string matches
+    return "^" + regexPattern + "$";
+}
+
+/**
+ * Using wildcards to match package names
+ * @param wildcardPkgName A package name pattern containing wildcard characters (e.g. com.example.*)
+ * @param pkgName The actual package name to be matched
+ * @return Returns the longest matching part, or an empty string if there is no match
+ * ROB-16097: To ensure configuration priority, MAP entries are sorted in the following order:
+ * com.example.xxx > com.example.* > *
+ */
+static std::string isPackageMatchedWildcard(const std::string& wildcardPkgName, const std::string& pkgName) {
+    if (wildcardPkgName.find("*") == std::string::npos || wildcardPkgName.empty() || wildcardPkgName.find_first_not_of(' ') == std::string::npos) {
+        return "";
+    }
+
+    std::string regexPattern = convertWildcardToRegex(wildcardPkgName);
+
+    std::regex pattern(regexPattern);
+    if (std::regex_match(pkgName, pattern)) {
+        return pkgName;
+    }
+
+    return "";
+}
+
