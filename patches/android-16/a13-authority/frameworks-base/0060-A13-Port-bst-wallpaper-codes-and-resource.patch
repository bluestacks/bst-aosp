diff --git a/core/java/android/app/WallpaperManager.java b/core/java/android/app/WallpaperManager.java
old mode 100644
new mode 100755
index dea1a050a27a..48ab47c9e284
--- a/core/java/android/app/WallpaperManager.java
+++ b/core/java/android/app/WallpaperManager.java
@@ -109,7 +109,7 @@ import java.util.concurrent.TimeUnit;
 @SystemService(Context.WALLPAPER_SERVICE)
 public class WallpaperManager {
     private static String TAG = "WallpaperManager";
-    private static final boolean DEBUG = false;
+    private static boolean DEBUG = SystemProperties.getBoolean("bst.debug.wallpaper", false);
     private float mWallpaperXStep = -1;
     private float mWallpaperYStep = -1;
     private static final @NonNull RectF LOCAL_COLOR_BOUNDS =
@@ -2425,12 +2425,26 @@ public class WallpaperManager {
             whichProp = PROP_LOCK_WALLPAPER;
             defaultResId = com.android.internal.R.drawable.default_lock_wallpaper;
             */
+            if (DEBUG) {
+                Log.d(TAG, "FLAG_LOCK returning null");
+            }
             return null;
         } else {
             whichProp = PROP_WALLPAPER;
-            defaultResId = com.android.internal.R.drawable.default_wallpaper;
+            String oem = SystemProperties.get("bst.oem", "");
+            if (oem.equals("msi5"))
+                defaultResId = com.android.internal.R.drawable.default_wallpaper_msi;
+            else
+                defaultResId = com.android.internal.R.drawable.default_wallpaper;
+
+            if (DEBUG) {
+                Log.d(TAG, "PROP_WALLPAPER " + defaultResId);
+            }
         }
         final String path = SystemProperties.get(whichProp);
+        if (DEBUG) {
+            Log.d(TAG, "path in openDefaultWallpaper " + path);
+        }
         final InputStream wallpaperInputStream = getWallpaperInputStream(path);
         if (wallpaperInputStream != null) {
             return wallpaperInputStream;
@@ -2440,6 +2454,11 @@ public class WallpaperManager {
         if (cmfWallpaperInputStream != null) {
             return cmfWallpaperInputStream;
         }
+
+        if (DEBUG) {
+            Log.d(TAG, "returning null from openDefaultWallpaper");
+        }
+
         try {
             return context.getResources().openRawResource(defaultResId);
         } catch (NotFoundException e) {
@@ -2453,9 +2472,15 @@ public class WallpaperManager {
             final File file = new File(path);
             if (file.exists()) {
                 try {
+                    if (DEBUG) {
+                        Log.d(TAG, "file exists");
+                    }
                     return new FileInputStream(file);
                 } catch (IOException e) {
                     // Ignored, fall back to platform default
+                    if (DEBUG) {
+                        Log.d(TAG, "exception while converting file to inputstream");
+                    }
                 }
             }
         }
