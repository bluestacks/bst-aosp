From 01b2f0acb905e95cece29dc47d34bd39d44a6dd2 Mon Sep 17 00:00:00 2001
From: mark-bst <zeqing.xu@bluestacks.com>
Date: Tue, 4 Aug 2026 19:25:47 +0800
Subject: [PATCH] [A16] Restore EFI variable support for installer

---
 src/Android.bp  | 81 +++++++++++++++++++++++++++++++++++++++++++++++++
 src/makeguids.c | 56 ++++++++++++++++++++++++++++++++--
 2 files changed, 135 insertions(+), 2 deletions(-)

diff --git a/src/Android.bp b/src/Android.bp
index 1e50541..a3c6ad1 100644
--- a/src/Android.bp
+++ b/src/Android.bp
@@ -19,3 +19,84 @@ cc_binary_host {
     ],
     host_ldlibs: ["-ldl"],
 }
+
+genrule {
+    name: "efivar_guid_source",
+    tools: ["makeguids"],
+    srcs: ["guids.txt"],
+    out: [
+        "guid-symbols.c",
+        "guids.generated.S",
+    ],
+    cmd: "mkdir -p $(genDir)/tmp $(genDir)/efivar && " +
+        "$(location makeguids) $(in) " +
+        "$(genDir)/tmp/guids.bin $(genDir)/tmp/names.bin " +
+        "$(genDir)/guid-symbols.c $(genDir)/tmp/efivar-guids.h " +
+        "$(genDir)/guids.generated.S",
+}
+
+genrule {
+    name: "efivar_guid_header",
+    tools: ["makeguids"],
+    srcs: ["guids.txt"],
+    out: ["efivar/efivar-guids.h"],
+    cmd: "mkdir -p $(genDir)/tmp $(genDir)/efivar && " +
+        "$(location makeguids) $(in) " +
+        "$(genDir)/tmp/guids.bin $(genDir)/tmp/names.bin " +
+        "$(genDir)/tmp/guid-symbols.c $(out)",
+}
+
+cc_library_static {
+    name: "libefivar",
+
+    srcs: [
+        "crc32.c",
+        "creator.c",
+        "disk.c",
+        "gpt.c",
+        "loadopt.c",
+        "path-helpers.c",
+        "linux-acpi-root.c",
+        "linux-acpi.c",
+        "linux-ata.c",
+        "linux-emmc.c",
+        "linux-i2o.c",
+        "linux-md.c",
+        "linux-nvme.c",
+        "linux-pci-root.c",
+        "linux-pci.c",
+        "linux-pmem.c",
+        "linux-sas.c",
+        "linux-sata.c",
+        "linux-scsi.c",
+        "linux-soc-root.c",
+        "linux-virtblk.c",
+        "linux.c",
+        "dp.c",
+        "dp-acpi.c",
+        "dp-hw.c",
+        "dp-media.c",
+        "dp-message.c",
+        "efivarfs.c",
+        "error.c",
+        "export.c",
+        "guid.c",
+        "lib.c",
+        "vars.c",
+    ],
+    generated_sources: ["efivar_guid_source"],
+    generated_headers: ["efivar_guid_header"],
+
+    local_include_dirs: ["include"],
+    export_include_dirs: [
+        "include",
+        "include/efivar",
+    ],
+    export_generated_headers: ["efivar_guid_header"],
+
+    cflags: [
+        "-D_FILE_OFFSET_BITS=64",
+        "-D_GNU_SOURCE",
+    ],
+    c_std: "gnu11",
+}
diff --git a/src/makeguids.c b/src/makeguids.c
index a15356b..328c2c3 100644
--- a/src/makeguids.c
+++ b/src/makeguids.c
@@ -55,6 +55,41 @@ cmpnamep(const void *p1, const void *p2)
 	return memcmp(gn1->name, gn2->name, sizeof (gn1->name));
 }
 
+static void
+write_asm_array(FILE *out, const char *symbol, const void *data, size_t size)
+{
+	const uint8_t *bytes = data;
+
+	fprintf(out,
+		"\t.globl %s\n"
+		"\t.data\n"
+		"\t.balign 16\n"
+		"\t.type\t%s, %%object\n"
+		"\t.size\t%s, %s_end - %s\n"
+		"%s:\n",
+		symbol, symbol, symbol, symbol, symbol, symbol);
+
+	for (size_t i = 0; i < size; i++) {
+		if (i % 12 == 0)
+			fputs("\t.byte ", out);
+		else
+			fputc(',', out);
+		fprintf(out, "0x%02x", bytes[i]);
+		if (i % 12 == 11 || i + 1 == size)
+			fputc('\n', out);
+	}
+
+	fprintf(out,
+		"\t.globl %s_end\n"
+		"\t.data\n"
+		"\t.balign 16\n"
+		"\t.type\t%s_end, %%object\n"
+		"\t.size\t%s_end, 1\n"
+		"%s_end:\n"
+		"\t.byte 0\n",
+		symbol, symbol, symbol, symbol);
+}
+
 struct guid_aliases {
 	char *name;
 	char *alias;
@@ -95,13 +130,13 @@ static void make_aliases(FILE *symout, FILE *header,
 int
 main(int argc, char *argv[])
 {
-	if (argc != 6)
+	if (argc != 6 && argc != 7)
 		exit(1);
 
 	int in, guidout, nameout;
 	int rc;
 
-	FILE *symout, *header;
+	FILE *symout, *header, *asmout = NULL;
 
 	in = open(argv[1], O_RDONLY);
 	if (in < 0)
@@ -129,6 +164,12 @@ main(int argc, char *argv[])
 	if (rc < 0)
 		warn("makeguids: chmod(%s, 0644)", argv[5]);
 
+	if (argc == 7) {
+		asmout = fopen(argv[6], "w");
+		if (asmout == NULL)
+			err(1, "makeguids: could not open \"%s\"", argv[6]);
+	}
+
 	char *inbuf = NULL;
 	size_t inlen = 0;
 	rc = read_file(in, (uint8_t **)&inbuf, &inlen);
@@ -235,11 +276,22 @@ main(int argc, char *argv[])
 	rc = write(guidout, outbuf, sizeof (struct guidname) * (line - 1));
 	if (rc < 0)
 		err(1, "makeguids");
+	if (asmout != NULL)
+		write_asm_array(asmout, "efi_well_known_guids", outbuf,
+				sizeof (struct guidname) * (line - 1));
 
 	qsort(outbuf, line-1, sizeof (struct guidname), cmpnamep);
 	rc = write(nameout, outbuf, sizeof (struct guidname) * (line - 1));
 	if (rc < 0)
 		err(1, "makeguids");
+	if (asmout != NULL) {
+		write_asm_array(asmout, "efi_well_known_names", outbuf,
+				sizeof (struct guidname) * (line - 1));
+		fputs("\n#if defined(__linux__) && defined(__ELF__)\n"
+		      ".section .note.GNU-stack,\"\",%progbits\n"
+		      "#endif\n", asmout);
+		fclose(asmout);
+	}
 	close(in);
 	close(guidout);
 	close(nameout);
-- 
2.34.1

