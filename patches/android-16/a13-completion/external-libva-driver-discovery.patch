From 313d3c0dbf612914d17cd1a02927c72a78e87d81 Mon Sep 17 00:00:00 2001
From: mark-bst <zeqing.xu@bluestacks.com>
Date: Wed, 5 Aug 2026 03:43:01 +0800
Subject: [PATCH] [A16] Point libva at installed VA-API drivers

---
 Android.bp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Android.bp b/Android.bp
index 8225063..c07749b 100644
--- a/Android.bp
+++ b/Android.bp
@@ -126,7 +126,7 @@ cc_library_shared {
 
     arch: {
         x86_64: {
-            cflags: ["-DVA_DRIVERS_PATH=\"/vendor/lib64\""],
+            cflags: ["-DVA_DRIVERS_PATH=\"/vendor/lib64/dri\""],
             enabled: true,
         },
     },
