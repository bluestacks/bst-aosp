From 15f58d06e049c579812e075a3ae0685e990ecdba Mon Sep 17 00:00:00 2001
From: Aaron He <aaron@bluestacks.com>
Date: Wed, 11 Oct 2023 10:49:57 +0800
Subject: [PATCH 029/224] [A13] Faking glesversion and features for playstore

1. Read gles version from config.db with higher priority
2. Fake reqiured features for vending app
3. Hide unused features from apps
---
 .../server/pm/PackageManagerService.java      | 122 +++++++++++++++++-
 .../server/wm/ActivityTaskManagerService.java |  21 +++
 2 files changed, 141 insertions(+), 2 deletions(-)

diff --git a/services/core/java/com/android/server/pm/PackageManagerService.java b/services/core/java/com/android/server/pm/PackageManagerService.java
index 47860373156b..91aed93ec864 100644
--- a/services/core/java/com/android/server/pm/PackageManagerService.java
+++ b/services/core/java/com/android/server/pm/PackageManagerService.java
@@ -157,6 +157,7 @@ import android.text.TextUtils;
 import android.text.format.DateUtils;
 import android.util.ArrayMap;
 import android.util.ArraySet;
+import android.util.BstUtils;
 import android.util.DisplayMetrics;
 import android.util.EventLog;
 import android.util.ExceptionUtils;
@@ -276,6 +277,8 @@ import java.util.concurrent.atomic.AtomicInteger;
 import java.util.concurrent.atomic.AtomicReference;
 import java.util.function.Consumer;
 
+import com.bluestacks.os.BstFilterAppsManager;
+
 /**
  * Keep track of all those APKs everywhere.
  * <p>
@@ -355,6 +358,9 @@ public class PackageManagerService implements PackageSender, TestUtilityService
