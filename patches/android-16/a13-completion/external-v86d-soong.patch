From 49e046362296556bc38b45bb4d971965eab21dfe Mon Sep 17 00:00:00 2001
From: mark-bst <zeqing.xu@bluestacks.com>
Date: Tue, 4 Aug 2026 18:35:30 +0800
Subject: [PATCH] [A16] Convert v86d to Soong

---
 Android.bp                        | 43 +++++++++++++++++++++++++++++++
 Android.mk => Android.mk.disabled |  0
 2 files changed, 43 insertions(+)
 create mode 100644 Android.bp
 rename Android.mk => Android.mk.disabled (100%)

diff --git a/Android.bp b/Android.bp
new file mode 100644
index 0000000..16beaf2
--- /dev/null
+++ b/Android.bp
@@ -0,0 +1,43 @@
+cc_binary {
+    name: "v86d",
+
+    srcs: [
+        "v86.c",
+        "v86_common.c",
+    ],
+
+    cflags: [
+        "-D__HAS_LONG_LONG__",
+        "-Wno-unused-parameter",
+    ],
+
+    arch: {
+        x86: {
+            srcs: [
+                "v86_lrmi.c",
+                "lrmi/lrmi.c",
+                "lrmi/x86-common.c",
+            ],
+            local_include_dirs: ["lrmi"],
+            cflags: [
+                "-DIF_MASK=X86_EFLAGS_IF",
+                "-DIOPL_MASK=X86_EFLAGS_IOPL",
+                "-DTF_MASK=X86_EFLAGS_TF",
+                "-DVIF_MASK=X86_EFLAGS_VIF",
+            ],
+        },
+        x86_64: {
+            srcs: [
+                "v86_mem.c",
+                "v86_x86emu.c",
+                "x86emu/decode.c",
+                "x86emu/fpu.c",
+                "x86emu/ops.c",
+                "x86emu/ops2.c",
+                "x86emu/prim_ops.c",
+                "x86emu/sys.c",
+            ],
+            local_include_dirs: ["x86emu"],
+        },
+    },
+}
diff --git a/Android.mk b/Android.mk.disabled
similarity index 100%
rename from Android.mk
rename to Android.mk.disabled
-- 
2.34.1

