+            // not mounted
+            if (DEBUG_STORAGE) {
+                Log.d(TAG, "Failed to store screenshot", e);
+            }
+            mParams.clearImage();
+            mImageData.reset();
+            mQuickShareData.reset();
+            mParams.mActionsReadyListener.onActionsReady(mImageData);
+            if (DEBUG_CALLBACK) {
+                Log.d(TAG, "Calling (Consumer<Uri>) finisher.accept(null)");
+            }
+            mParams.finisher.accept(null);
+        }
