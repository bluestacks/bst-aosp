+        @Override
+        protected boolean isBluestacksFilter(Pair<ParsedActivity, ParsedIntentInfo> filter, List<ResolveInfo> dest) {
+
+            Trace.traceBegin(TRACE_TAG_PACKAGE_MANAGER, "isBluestacksFilter");
+
+            ParsedActivity parsedActivity = filter.first;
+            String packageName = parsedActivity.getPackageName();
+            int uid = Binder.getCallingUid();
+            // This function is to tell IntentResolver if this check has filter for intents related to bluestacks packages
+            // being queried by some app. If yes, we return true to prevent bluestacks packages from being listed.
+
+            if (uid >= 10000 && packageName != null && packageName.startsWith("com.bluestacks")) {
+                if (uid != Process.SYSTEM_UID) {
+                    int pid = Binder.getCallingPid();
+                    String callingPackage = BstUtils.getAppNameFromPid(pid);
+                    boolean isHideFromPkg = false;
+
+                    try {
+                        if (mBstfilter == null)
+                            mBstfilter = IBstFilterAppsService.Stub.asInterface(ServiceManager.getService(Context.BST_FILTER_APPS));
+                        isHideFromPkg = mBstfilter.isHideBstActivityInfo(callingPackage);
+                    } catch (Exception e) {
+                        e.printStackTrace();
+                    }
+
+                    if (isHideFromPkg) {
+                        boolean isAppPrivileged = BstUtils.bstIsCallingAppPrivileged(uid, callingPackage);
+
+                        if (DEBUG_SHOW_INFO)
+                            Log.v(TAG, "pkg: " + callingPackage + " asking for: " + parsedActivity.getName() + "  pkg:" + packageName);
+
+                        if (BstUtils.hideBlueStacksPkg(packageName, isAppPrivileged)) {
+                            return true;
+                        }
+                    }
+                }
+            }
+            Trace.traceEnd(TRACE_TAG_PACKAGE_MANAGER);
+            return false;
+        }
+
